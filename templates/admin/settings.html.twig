{% extends 'base.html.twig' %} {% block title %}Les Parenthèses Dorées -
Paramétrages{% endblock %} {% block body %}
<main class="pt-5">
    <h1 class="text-center m-5">Paramétrages</h1>
    <!-- Tarifs -->
    <section class="container-fluid pb-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card shadow-sm border-gold">
                        <div class="card-header bg-blue text-gold py-3">
                            <h3 class="text-center m-2">Tarifs</h3>
                        </div>
                        <div class="card-body p-0">
                            <div class="text-center m-2">
                                <a
                                    href="{{ path('app_period_index') }}"
                                    class="btn btn-sm"
                                >
                                    Gérer les périodes
                                </a>
                            </div>
                            <!-- Version mobile -->
                            <div class="d-md-none">
                                {% for period in periods %} {% for rate in
                                period.rates %}
                                <div class="card m-2 shadow-sm">
                                    <div class="card-body">
                                        <h6 class="fw-bold mb-2">
                                            {{ rate.room.name }} —
                                            {{ period.name }}
                                        </h6>

                                        <p class="mb-1">
                                            <strong>Prix :</strong>
                                            {{ rate.amount }} €
                                        </p>

                                        <p class="mb-1">
                                            <strong>Du :</strong>
                                            {{ period.startingDate|date('d/m/Y') }}
                                        </p>

                                        <p class="mb-1">
                                            <strong>Au :</strong>
                                            {{ period.endingDate|date('d/m/Y') }}
                                        </p>

                                        <a
                                            href="{{
                                                path('app_rate_show', {
                                                    id: rate.id
                                                })
                                            }}"
                                            class="btn btn-sm w-100 mt-2"
                                        >
                                            Voir le tarif
                                        </a>
                                    </div>
                                </div>
                                {% endfor %} {% else %}
                                <p class="text-center">
                                    Aucune période tarifaire active
                                </p>
                                {% endfor %}
                            </div>
                            <!-- Version desktop -->
                            <div
                                class="table-responsive shadow-sm border d-none d-md-block"
                            >
                                <table
                                    class="table table-hover align-middle mb-0"
                                >
                                    <thead>
                                        <tr>
                                            <th scope="col">Chambre</th>
                                            <th scope="col">Prix / nuit</th>
                                            <th scope="col">Nom</th>
                                            <th scope="col">Date début</th>
                                            <th scope="col">Date fin</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for period in periods %} {% for rate
                                        in period.rates %}
                                        <tr>
                                            <td>{{ rate.room.name }}</td>
                                            <td>{{ rate.amount }} €</td>
                                            <td>{{ period.name }}</td>
                                            <td>
                                                {{ period.startingDate ? period.startingDate|date('Y-m-d') : '' }}
                                            </td>
                                            <td>
                                                {{ period.endingDate ? period.endingDate|date('Y-m-d') : '' }}
                                            </td>
                                            <td>
                                                <a
                                                    class="btn btn-sm"
                                                    href="{{
                                                        path('app_rate_show', {
                                                            id: rate.id
                                                        })
                                                    }}"
                                                    >Voir</a
                                                >
                                            </td>
                                        </tr>
                                        {% endfor %} {% else %}
                                        <tr>
                                            <td colspan="6">
                                                Aucune période tarifaire active
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bouton -->
            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_rate_new') }}"
                    >Ajouter un tarif</a
                >
            </div>
        </div>
    </section>

    <!-- Chambres -->
    <section class="container-fluid pb-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card shadow-sm border-gold">
                        <div class="card-header bg-blue text-gold py-3">
                            <h3 class="text-center m-2">Chambres</h3>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive shadow-sm border">
                                <table
                                    class="table table-hover align-middle mb-0"
                                >
                                    <thead>
                                        <tr>
                                            <th scope="col">#</th>
                                            <th scope="col">Nom</th>
                                            <th scope="col">Statut</th>
                                            <th scope="col">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for room in rooms %}
                                        <tr>
                                            <td>{{ room.number }}</td>
                                            <td>{{ room.name }}</td>
                                            <td>{{ room.status.value }}</td>
                                            <td>
                                                <a
                                                    class="btn btn-sm"
                                                    href="{{
                                                        path('app_room_show', {
                                                            id: room.id
                                                        })
                                                    }}"
                                                    >Voir</a
                                                >
                                            </td>
                                        </tr>
                                        {% else %}
                                        <tr>
                                            <td colspan="4">
                                                Aucune chambre enregistrée
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bouton -->
            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_room_new') }}"
                    >Ajouter une chambre</a
                >
            </div>
        </div>
    </section>

    <!-- Utilisateurs -->
    <section class="container-fluid pb-5">
        <div class="container">
            <!-- Liste -->
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card shadow-sm border-gold">
                        <div class="card-header bg-blue text-gold py-3">
                            <h3 class="text-center m-2">Utilisateurs</h3>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive shadow-sm border">
                                <table
                                    class="table table-hover align-middle mb-0"
                                >
                                    <thead>
                                        <tr>
                                            <th scope="col">Email</th>
                                            <th scope="col">Rôle</th>
                                            <th scope="col" class="text-center">
                                                Action
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for user in users %}
                                        <tr>
                                            <td>{{ user.email }}</td>
                                            <td>
                                                {% for role in user.roles %} {%
                                                if role != 'ROLE_USER' %}
                                                {{ role|replace({'ROLE_': ''}) }}
                                                {% endif %} {% endfor %}
                                            </td>
                                            <td class="text-center">
                                                <a
                                                    class="btn btn-sm"
                                                    href="{{
                                                        path('app_user_show', {
                                                            id: user.id
                                                        })
                                                    }}"
                                                    >Voir</a
                                                >
                                            </td>
                                        </tr>
                                        {% else %}
                                        <tr>
                                            <td colspan="3">
                                                Aucun utilisateur trouvé.
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bouton -->
            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_user_new') }}"
                    >Ajouter un utilisateur</a
                >
            </div>
        </div>
    </section>
</main>
{% endblock %}
