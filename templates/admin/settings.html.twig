{% extends 'base.html.twig' %} {% block title %}Les Parenthèses Dorées -
Paramétrages{% endblock %} {% block body %}
<main class="pt-5">
    <h1 class="text-center m-5">Paramétrages</h1>
    <!-- Tarifs -->
    <section class="container-fluid py-5">
        <div class="container">
            <h2 class="text-center m-5">Périodes tarifaires</h2>

            <!-- Liste -->
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="table-responsive shadow-sm border rounded">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Nom</th>
                                    <th>Date début</th>
                                    <th>Date fin</th>
                                    <th>Prix / nuit</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for period in periods %}
                                <tr>
                                    <td>{{ period.name }}</td>
                                    <td>
                                        {{ period.startingDate ? period.startingDate|date('Y-m-d') : '' }}
                                    </td>
                                    <td>
                                        {{ period.endingDate ? period.endingDate|date('Y-m-d') : '' }}
                                    </td>
                                    <td>
                                        {% for rate in period.rates %}
                                        {{ rate.price }} €{% if not loop.last
                                        %}, {% endif %} {% endfor %}
                                    </td>

                                    <td>
                                        <a
                                            class="btn btn-sm"
                                            href="{{
                                                path('app_period_show', {
                                                    id: period.id
                                                })
                                            }}"
                                            >Voir</a
                                        >
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="5">
                                        Aucune période tarifaire active
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bouton -->
            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_period_new') }}"
                    >Ajouter une période tarifaire</a
                >
            </div>
        </div>
    </section>

    <!-- Chambres -->
    <section class="container-fluid py-5">
        <div class="container">
            <h2 class="text-center m-5">Chambres</h2>

            <!-- Liste -->
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="table-responsive shadow-sm border rounded">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Status</th>
                                    <th>actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for room in rooms %}
                                <tr>
                                    <td>{{ room.name }}</td>
                                    <td>{{ room.status }}</td>
                                    <td>
                                        <a
                                            class="btn btn-sm"
                                            href="{{
                                                path('app_room_show', {
                                                    id: room.id
                                                })
                                            }}"
                                            >Voir</a
                                        >
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="3">
                                        Aucune chambre enregistrée
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bouton -->
            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_room_new') }}"
                    >Ajouter une chambre</a
                >
            </div>
        </div>
    </section>

    <!-- Utilisateurs -->
    <section class="container-fluid py-5">
        <div class="container">
            <h2 class="text-center m-5">Utilisateurs</h2>

            <!-- Liste -->
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="table-responsive shadow-sm border rounded">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Email</th>
                                    <th scope="col">Rôle</th>
                                    <th scope="col" class="text-center">
                                        Actions
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for user in users %}
                                <tr>
                                    <td>{{ user.email }}</td>
                                    <td>
                                        {% for role in user.roles %} {% if role
                                        != 'ROLE_USER' %}
                                        {{ role|replace({'ROLE_': ''}) }}
                                        {% endif %} {% endfor %}
                                    </td>
                                    <td class="text-center">
                                        <a
                                            class="btn btn-sm"
                                            href="{{
                                                path('app_user_show', {
                                                    id: user.id
                                                })
                                            }}"
                                            >Voir</a
                                        >
                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="3">
                                        Aucun utilisateur trouvé.
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bouton -->
            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_user_new') }}"
                    >Ajouter un utilisateur</a
                >
            </div>
        </div>
    </section>
</main>
{% endblock %}
