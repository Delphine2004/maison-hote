{% extends 'base.html.twig' %}
{% block title %}Les Parenthèses Dorées -
							Paramétrages
{% endblock %}
{% block body %}
	<main class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<h1 class="text-center m-2">Informations établissement</h1>
						<div class="card-body bg-blue text-gold shadow-sm border-gold p-5 m-5">
							<div class="row g-3 justify-content-center">
								<div class="col-12 col-md-5">
									<a href="{{path('app_service_index')}}" class="btn w-100">
										Services
									</a>
								</div>
								<div class="col-12 col-md-5">
									<a href="{{path('app_picture_index')}}" class="btn w-100">
										Photos
									</a>
								</div>
							</div>
						</div>
						<div class="card shadow-sm border-gold m-5">
							<div class="card-header bg-blue text-gold py-3">
								<h3 class="text-center m-2">Chambres</h3>
							</div>
							<div
								class="card-body p-0">
								<!-- Version mobile -->
								<div class="d-md-none">
									{% for room in rooms %}
										<div class="card m-2 shadow-sm">
											<div class="card-body">
												<h6 class="fw-bold mb-2">
													{{ room.name }}
												</h6>

												<p class="mb-1">
													<strong>Numéro :</strong>
													{{ room.number }}
												</p>
												<p class="mb-1">
													<strong>Statut :</strong>
													{{ room.status.value }}
												</p>
												<a href="{{ path('app_room_show', { id: room.id }) }}" class="btn btn-sm w-100 mt-2">
													Voir
												</a>
											</div>
										</div>
									{% else %}
										<p class="text-center m-2">
											Aucune chambre enregistrée
										</p>
									{% endfor %}
								</div>
								<!-- Version desktop -->
								<div class="table-responsive shadow-sm d-none d-md-block">
									<table class="table table-hover align-middle mb-0">
										<thead>
											<tr>
												<th scope="col">#</th>
												<th scope="col">Nom</th>
												<th scope="col">Statut</th>
												<th scope="col">Action</th>
											</tr>
										</thead>
										<tbody>
											{% for room in rooms %}
												<tr>
													<td>{{ room.number }}</td>
													<td>{{ room.name }}</td>
													<td>{{ room.status.value }}</td>
													<td>
														<a class="btn btn-sm" href="{{ path('app_room_show', { id: room.id }) }}">Voir</a>
													</td>
												</tr>
											{% else %}
												<tr>
													<td colspan="4">
														Aucune chambre enregistrée
													</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>
							<div class="card-footer bg-blue py-3">
								<div class="text-center m-2">
									<a class="btn" href="{{ path('app_room_new') }}">Ajouter une chambre</a>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="text-center m-5">
					<a class="btn" href="{{ path('app_settings_index') }}">Retour aux paramétres</a>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
