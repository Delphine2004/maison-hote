{% extends 'base.html.twig' %}
{% block title %}Les Parenthèses Dorées -Paramétrages
{% endblock %}
{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-3">Informations établissement</h1>
							</div>

							<div class="card-body p-5">
								<div class="row justify-content-center g-3">

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{path('app_service_index')}}">
											Services
										</a>
									</div>

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{path('app_picture_index')}}">
											Photos
										</a>
									</div>
								</div>

							</div>
						</div>

						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_settings_index') }}">Retour aux paramétres</a>
						</div>

						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h2 class="text-center m-3">Chambres</h2>
							</div>
							<div class="card-body p-0">
								{% for room in rooms %}
									<div class="card d-flex flex-md-row shadow-sm m-3">
										<div class="card-body d-flex flex-column flex-md-row justify-content-md-between align-items-center p-3">
											<h6 class="fw-bold mb-2">
												{{ room.name }}
											</h6>
											<p class="mb-1">
												{{ room.number }}
											</p>
											<p class="mb-1">
												{{ room.status.value }}
											</p>
										</div>
										<div class="d-flex flex-row flex-md-row justify-content-center align-items-center gap-3 p-3">
											<a href="{{ path('app_room_show', { id: room.id }) }}" class="btn">
												Voir
											</a>
										</div>
									</div>
								{% else %}
									<p class="text-center m-2">
										Aucune chambre enregistrée
									</p>
								{% endfor %}
							</div>
							<div class="card-footer bg-blue py-5">
								<div class="row justify-content-evenly g-3">
									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_room_new') }}">Ajouter une chambre</a>
									</div>
								</div>
							</div>
						</div>

					</div>
				</div>

			</div>
		</section>
	</main>
{% endblock %}
