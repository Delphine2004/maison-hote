{% extends 'base.html.twig' %}

{% block title %}Les Parenthèses Dorées - Paramétrages
{% endblock %}

{% block body %}

	<main class="py-5">

		<section class="container-fluid my-5">
			<div class="container">

				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_settings_index') }}">Retour aux paramétres</a>
						</div>

					</div>

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-3">Informations établissement</h1>
							</div>

							<div class="card-body p-5">
								<div class="row justify-content-around g-5">
									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{path('app_service_index')}}">
											Services
										</a>
									</div>

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{path('app_picture_index')}}">
											Photos
										</a>
									</div>

								</div>

							</div>
						</div>
					</div>

				</div>

			</div>
		</section>

		<section class="container-fluid my-5">
			<div class="container">

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h2 class="text-center m-3">Chambres</h2>
							</div>

							<div class="card-body p-0">
								{% for room in rooms %}
									<div class="card d-flex flex-row flex-wrap align-items-center shadow-sm m-3">
										<div class="card-body d-flex flex-row flex-wrap justify-content-between align-items-center p-3">
											<p class="m-0">
												#{{ room.number }}
												-
												{{ room.name }}
											</p>
											<p class="m-0">
												{{ room.rate }}
											</p>
										</div>

										<div class="d-flex justify-content-center align-items-center p-3">
											<a class="btn w-100" href="{{ path('app_room_show', { id: room.id }) }}">
												Voir
											</a>
										</div>
									</div>
								{% else %}
									<p class="text-center m-2">
										Aucune chambre enregistrée
									</p>
								{% endfor %}
							</div>

						</div>
					</div>
				</div>

			</div>
		</section>
	</main>
{% endblock %}
