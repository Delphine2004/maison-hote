{% extends 'base.html.twig' %}
{% block title %}Les Parenthèses Dorées -
					Paramétrages
{% endblock %}
{% block body %}
	<main class="pt-5">

		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm border-gold m-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-2">Utilisateurs</h1>
							</div>
							<div class="card-body p-0">
								<div class="table-responsive shadow-sm">
									<table class="table table-hover align-middle mb-0">
										<thead>
											<tr>
												<th scope="col">Email</th>
												<th scope="col">Rôle</th>
												<th scope="col" class="text-center">
													Action
												</th>
											</tr>
										</thead>
										<tbody>
											{% for user in users %}
												<tr>
													<td>{{ user.email }}</td>
													<td>
														{% for role in user.roles %}
															{%
                                                if role != 'ROLE_USER' %}
																{{ role|replace({'ROLE_': ''}) }}
															{% endif %}
														{% endfor %}
													</td>
													<td class="text-center">
														<a class="btn btn-sm" href="{{ path('app_user_show', { id: user.id }) }}">Voir</a>
													</td>
												</tr>
											{% else %}
												<tr>
													<td colspan="3">
														Aucun utilisateur trouvé.
													</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>
							<div class="card-footer bg-blue py-3">
								<div class="text-center m-2">
									<a class="btn" href="{{ path('app_staff_new') }}">Ajouter un utilisateur</a>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="text-center m-5">
					<a class="btn" href="{{ path('app_settings_index') }}">Retour aux paramétres</a>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
