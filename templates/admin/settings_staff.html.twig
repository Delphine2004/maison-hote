{% extends 'base.html.twig' %}

{% block title %}Les Parenthèses Dorées - Paramétrages
{% endblock %}

{% block body %}

	<main class="py-5">

		<section class="container-fluid my-5">
			<div class="container">

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_settings_index') }}">Retour aux paramétres</a>
						</div>
					</div>

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm my-5">
							<div class="card-header py-3">
								<h1>Utilisateurs</h1>
							</div>

							<div class="card-body p-0">
								<div class="row flex-column justify-content-center align-items-center">

									{% for label, messages in app.flashes %}
										<div class="col-12 col-md-10">
											{% for message in messages %}
												<p class="fw-bold text-center  m-3 alert alert-{{ label }}">
													{{ message }}
												</p>
											{% endfor %}
										</div>
									{% endfor %}

									<div class="col-12 col-md-4">
										<div class="text-center m-3">
											<a class="btn btn-sm" href="{{ path('app_staff_new') }}">Ajouter un utilisateur</a>
										</div>
									</div>

									<div class="col-12 ">
										{% for user in users %}
											<div class="card flex-row flex-wrap align-items-center shadow-sm m-3">
												<div class="card-body d-flex flex-row flex-wrap justify-content-between align-items-center p-3">
													<p class="m-0">{{ user.email }}</p>
													<p class="m-0">
														{% for role in user.roles %}
															{% if role != 'ROLE_USER' %}
																{{ role|replace({'ROLE_': ''}) }}
															{% endif %}
														{% endfor %}
													</p>
												</div>

												<div class="d-flex justify-content-center align-items-center p-3">
													<a class="btn w-100" href="{{ path('app_user_show', { id: user.id }) }}">Voir</a>
												</div>
											</div>
										{% else %}
											<p class="text-center m-2">
												Aucun utilisateur trouvé.
											</p>
										{% endfor %}

									</div>
								</div>
							</div>
						</div>
					</div>

				</div>

			</div>
		</section>

	</main>
{% endblock %}
