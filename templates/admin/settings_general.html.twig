{% extends 'base.html.twig' %}
{% block title %}Les Parenthèses Dorées -Paramétrages
{% endblock %}
{% block body %}
	<main class="py-5">
		<section class="container-fluid my-5">
			<div class="container">

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card shadow-sm my-5">
							<div class="card-header py-3">
								<h1>Paramétrages</h1>
							</div>

							<div class="card-body p-5">
								<div class="row justify-content-around g-5">

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_hotel_settings') }}">
											Etablissement
										</a>
									</div>

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_staff_index') }}">
											Utilisateurs
										</a>
									</div>

									{% for label, messages in app.flashes %}
										<div class="col-12 col-md-10">
											{% for message in messages %}
												<p class="fw-bold text-center  m-3 alert alert-{{ label }}">
													{{ message }}
												</p>
											{% endfor %}
										</div>
									{% endfor %}

								</div>
							</div>

						</div>

					</div>
				</div>
			</div>
		</section>

	</main>
{% endblock %}
