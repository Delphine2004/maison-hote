{{ form_start(form, {'attr': {'novalidate':  true}}) }}
<div class="row g-3 justify-content-around mb-3">
	<div class="col-12 mb-3">
		{{ form_label(form.picture) }}
		{{ form_widget(form.picture) }}
		{{ form_errors(form.picture) }}
	</div>
</div>

<div class="row g-3 justify-content-around mb-3">
	<div class="col-12 col-md-4 mb-3">
		<button class="btn w-100">{{ button_label|default('Enregistrer') }}</button>
	</div>

	<div class="col-12 text-gold mb-3">
		{{ form_errors(form) }}
	</div>
</div>

{{ form_end(form) }}
