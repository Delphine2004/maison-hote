{% extends 'base.html.twig' %}
{% block title %}Paramétrage - Ajout photo
{% endblock %}
{% block body %}
	<main class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card bg-blue border-gold shadow-sm d-flex justify-content-evenly p-4">
							<h1 class="text-center text-gold m-2">Ajouter une photo</h1>
							{{ include('picture/_form.html.twig') }}
						</div>
					</div>
				</div>
				<div class="text-center m-5">
					<a class="btn" href="{{ path('app_picture_index') }}">Retour aux photos</a>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
