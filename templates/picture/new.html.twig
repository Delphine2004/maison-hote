{% extends 'base.html.twig' %}
{% block title %}Paramétrage - Ajout photo
{% endblock %}
{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card bg-blue shadow-sm justify-content-evenly p-4 my-5">
							<h1 class="text-center m-5">Ajouter une photo</h1>
							{{ include('picture/_form.html.twig') }}
						</div>
					</div>
					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_picture_index') }}">Retour aux photos</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
