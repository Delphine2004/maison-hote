{% extends 'base.html.twig' %}
{% block title %}Espace administrateur -
														Photos
{% endblock %}
{% block body %}

	<main class="py-5">
		<section class="container-fluid my-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10">

						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-3">Photos</h1>
							</div>

							<div class="card-body p-5">
								<div class="row justify-content-center g-3">

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_picture_new') }}">Ajouter une photo</a>
									</div>
                  
								</div>
							</div>
						</div>
					</div>

					<div class="text-center m-3">
						<a class="btn" href="{{ path('app_hotel_settings') }}">Retour aux paramétres</a>
					</div>

				</div>
			</div>
		</section>

		<section class="container-fluid my-5">
			<div class="container">
				<div class="row justify-content-center g-4">

					{% for picture in pictures %}
						<div class="col-12 col-md-5">
							<div class="card border-gold shadow-sm h-100 my-4">

								<img src="{{ asset('uploads/pictures/' ~ picture.picture) }}" alt="image {{ picture.id }}" class="card-img-top pictures-list "/>

								<div class="card-body bg-blue text-gold d-flex justify-content-center ">
									{{include("picture/_delete_form.html.twig")}}
								</div>

							</div>
						</div>
					{% else %}
						<p class="text-center">Aucune photo enregistrée</p>
					{% endfor %}

				</div>
			</div>
		</section>

	</main>
{% endblock %}
