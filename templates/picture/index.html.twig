{% extends 'base.html.twig' %}

{% block title %}Espace administrateur - Photos
{% endblock %}

{% block body %}

	<main class="py-5">

		<section class="container-fluid my-5">
			<div class="container">

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_hotel_settings') }}">Retour aux paramétres</a>
						</div>
					</div>

					<div class="col-12 col-md-10">
						<div class="card shadow-sm my-5">
							<div class="card-header py-3">
								<h1>Photos</h1>
							</div>

							<div class="card-body p-5">
								<div class="row justify-content-center">

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_picture_new') }}">Ajouter une photo</a>
									</div>

									{% for label, messages in app.flashes %}
										<div class="col-12 col-md-10">
											{% for message in messages %}
												<p class="fw-bold text-center m-3 alert alert-{{ label }}">
													{{ message }}
												</p>
											{% endfor %}
										</div>
									{% endfor %}
								</div>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>

		<section class="container-fluid my-5">
			<div class="container">
				<div class="row justify-content-center g-4">

					{% for picture in pictures %}
						<div class="col-12 col-md-5">
							<div class="card shadow-sm my-4">

								<div class="card-body p-0">
									<img class="pictures-list" src="{{ asset('uploads/pictures/' ~ picture.picture) }}" alt="image {{ picture.id }}"/>
								</div>

								<div class="card-footer p-3">
									<div class="row justify-content-evenly g-3">
										<div class="col-12 col-md-4">
											<div class="flex-fill">
												{{include("picture/_delete_form.html.twig")}}
											</div>
										</div>
									</div>
								</div>
							</div>

						</div>

					{% else %}
						<div class="col-12">
							<div class="card shadow-sm my-4">
								<p class="text-center">Aucune photo enregistrée</p>
							</div>
						</div>
					{% endfor %}

				</div>
			</div>
		</section>

	</main>
{% endblock %}
