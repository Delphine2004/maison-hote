{{ form_start(form, {'attr': {'novalidate':  true}}) }}
<div class="row g-3 justify-content-around my-3">
	<div class="col-md-4">
		{{ form_label(form.id) }}
		{{ form_widget(form.id, {
        attr: {
            class: 'form-control'
        }
    }) }}
	</div>
	<div class="col-md-4">
		{{ form_label(form.rate) }}
		{{ form_widget(form.rate, {
        attr: {
            class: 'form-control'
        }
    }) }}
	</div>
	<div class="col-md-4">
		{{ form_label(form.status) }}
		{{ form_widget(form.status, {
        attr: {
            class: 'form-select'
        }
    }) }}
	</div>
</div>

<div class="row g-3 justify-content-around my-3">
	<div class="col-md-6">
		{{ form_label(form.createdAt) }}
		{{ form_widget(form.createdAt, {
        attr: {
            class: 'form-control'
        }
    }) }}
	</div>
	<div class="col-md-6">
		{{ form_label(form.room) }}
		{{ form_widget(form.room, {
        attr: {
            class: 'form-control'
        }
    }) }}
	</div>

</div>

<div class="row justify-content-center my-3">
	<div class="col-12 col-md-4 mb-3">
		<button class="btn w-100" type="submit">Rechercher</button>
	</div>

	<div class="col-12 mb-3">
		{{ form_errors(form.id) }}
		{{ form_errors(form.rate) }}
		{{ form_errors(form.status) }}
		{{ form_errors(form.createdAt) }}
		{{ form_errors(form.room) }}
		{{ form_errors(form) }}
	</div>

	<div class="col-12 col-md-4 mb-3">
		<div class="text-center">
			<a href="{{ path('app_search_review') }}">Réinitialiser</a>
		</div>
	</div>
</div>

{{ form_end(form) }}
