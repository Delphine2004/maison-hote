<form
    method="post"
    action="{{ path('app_review_reject', { id: review.id }) }}"
    onsubmit="return confirm('Confirmez vous le rejet?');"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('reject' ~ review.id) }}"
    />
    <button class="btn w-100">Rejeter</button>
</form>