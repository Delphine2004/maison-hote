{% extends 'base.html.twig' %}
{% block title %}Recherche commentaires
{% endblock %}
{%
block body %}

  <main class="py-5">
    <section class="container-fluid">
      <div class="container">
        <div class="row justify-content-center">

          <div class="col-12 col-md-10 col-lg-8">
            <div class="card card-form shadow-sm p-3 my-5">
              <h1>Rechercher</h1>
              {{ include("review/_search.html.twig") }}
            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="container-fluid">
      <div class="container">

        <div class="row justify-content-center align-items-center my-4">
          <div class="col-12 col-md-10 col-lg-8">
            {% for review in reviews %}
              <div class="card flex-column flex-md-row align-items-center shadow-sm my-2">
                <div class="row justify-content-center align-items-center w-100 g-3">
                  <div class="col-12 col-md-9">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 p-3">
                      <p class="my-3">{{ review.id }}</p>
                      <p class="my-3">{{ review.rate }}/5</p>
                      <p class="my-3">{{ review.booking.room.name }}</p>
                      <p class="my-3">{{ review.createdAt ? review.createdAt|date('d/m/Y H:i:s') : '' }}</p>
                    </div>
                  </div>
                  <div class="col-12 col-md-2 text-center my-3">
                    <a class="btn w-100" target="_blank" href="{{ path('app_review_show', { id: review.id }) }}">Voir</a>
                  </div>
                </div>
              </div>
            {% else %}
              <p class="text-center m-2">
                Aucun commentaire ne correspond à la recherche.
              </p>
            {% endfor %}

          </div>
        </div>
        
      </div>
    </section>
  </main>

{% endblock %}
