{% extends 'base.html.twig' %}
{% block title %}Réservations - Rechercher
{% endblock %}
{% block body %}
	<main class="py-5">

		<!-- Recherche de réservation -->
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card bg-blue shadow-sm border-gold text-gold p-3 my-5">
							<h3 class="text-center mb-4">Rechercher</h3>

							<form id="search-booking-form">
								<div
									class="row g-3 mb-3 justify-content-around">
									<!-- Id -->
									<div class="col-md-4">
										<label class="form-label" for="booking-id">Référence</label>
										<input class="form-control" type="number" name="booking_id" id="booking-id" min="1" step="1"/>
									</div>

									<!-- Nom client -->
									<div class="col-md-4">
										<label class="form-label" for="last-name">Nom</label>
										<input class="form-control" type="text" name="last_name" id="last-name" minlength="2" maxlength="100"/>
									</div>

									<!-- Statut de réservation -->
									<div class="col-md-4">
										<label class="form-label" for="status">Statut</label>
										<select class="form-select" name="status" id="status">
											<option selected value="">
												Sélectionner un statut
											</option>
											<option value="Confirmée">
												Confirmée
											</option>
											<option value="Present">Present</option>
											<option value="Finalisé">
												Finalisé
											</option>
											<option value="Annulé">Annulé</option>
										</select>
									</div>
								</div>
								<div
									class="row g-3 mb-3 justify-content-around">
									<!-- Date arrivée -->
									<div class="col-md-4">
										<label class="form-label" for="arrival-date">Date d'arrivée</label>
										<input class="form-control" type="date" name="arrival_date" id="arrival-date"/>
									</div>

									<!-- Date départ -->
									<div class="col-md-4">
										<label class="form-label" for="departure-date">Date de départ</label>
										<input class="form-control" type="date" name="departure_date" id="departure-date"/>
									</div>

									<!-- Date création -->
									<div class="col-md-4">
										<label class="form-label" for="creation-date">Date de création</label>
										<input class="form-control" type="date" name="creation_date" id="creation-date"/>
									</div>
								</div>
								<div class="text-center">
									<button type="submit" class="btn">
										Rechercher
									</button>
								</div>
							</form>
						</div>

					</div>
				</div>
        
				<div class="row justify-content-center align-items-center my-4">
					<div class="col-12 col-md-10 col-lg-8">

						{% for booking in bookings %}
							<div class="card border-gold shadow-sm d-flex flex-column flex-md-row align-items-center p-1 m-1">
								<div class="d-flex flex-column flex-md-row align-items-center flex-grow-1">
									<p class="m-3">{{ booking.id }}</p>
									<p class="m-3">{{ booking.user.lastName }}
										{{ booking.user.firstName }}</p>
									<p class="m-3">{{ booking.startingDate ? booking.startingDate|date('d/m/Y') : ''}}</p>
									<p class="m-3">{{ booking.endingDate ? booking.endingDate|date('d/m/Y') : ''}}</p>
								</div>
								<div class="m-3">
									<a class="btn" href="{{ path('app_client_show', { id: booking.user.id }) }}">Voir</a>
									<a class="btn" href="{{ path('app_booking_show', { id: booking.id }) }}">Voir</a>
								</div>
							</div>
						{% else %}
							<p class="text-center m-2">
								Aucune réservation ne correspond à la recherche.
							</p>
						{% endfor %}

					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
