												</p>
												<p class="mb-1">
													<strong>Total :
													</strong>
													{{ booking.totalAmount }}
												</p>
												{{ include("booking/_in_form.html.twig" )}}
											</div>
										</div>

									{% else %}
										<p class="text-center m-2">
											Aucun arrivée ce jour
										</p>
									{% endfor %}
								</div>
								<!-- Version desktop -->
								<div class="table-responsive shadow-sm d-none d-md-block">
									<table class="table table-hover align-middle mb-0">
										<thead>
											<tr>
												<th>Ref</th>
												<th>Client</th>
												<th>Chambre</th>
												<th>Arrivée</th>
												<th>Départ</th>
												<th>Total</th>
												<th>Action</th>
											</tr>
										</thead>
										<tbody>
											{% for booking in checkins %}
												<tr>
													<td>{{ booking.id }}</td>
													<td>
														{{ booking.user.lastName }}
														{{ booking.user.firstName }}
													</td>
													<td>{{ booking.room.name }}</td>
													<td>
														{{ booking.startingDate ? booking.startingDate|date('d/m/Y') : '' }}
													</td>
													<td>
														{{ booking.endingDate ? booking.endingDate|date('d/m/Y') : '' }}
													</td>
													<td>{{ booking.totalAmount }}</td>
													<td>
														{{ include("booking/_in_form.html.twig" )}}
													</td>
												</tr>
											{% else %}
												<tr>
													<td colspan="7">
														Aucune arrivée ce jour
													</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
