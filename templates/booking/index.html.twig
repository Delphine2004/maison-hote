{% extends 'base.html.twig' %}
{% block title %}Réservations
{% endblock %}
{% block body %}
	<main
		class="py-5">

		<!-- Ajouter ou rechercher une réservation  -->
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-3">Réservations</h1>
							</div>
							<div class="card-body p-5">
								<div class="row justify-content-center g-3">
                
									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_search_room') }}">Ajouter</a>
									</div>

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_booking_search') }}">Rechercher</a>
									</div>

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_booking_statistics') }}">Statistiques</a>
									</div>

								</div>
							</div>
						</div>

					</div>
				</div>
			</div>
		</section>

		<!-- Liste des nouvelles réservations -->
		<section class="container-fluid">
			<div
				class="container">
				<!-- Liste -->
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h2 class="text-center">
									Réservations du jour
								</h2>
							</div>
							<div class="card-body p-0">
								{% for booking in todayBookings %}
									<div class="card d-flex flex-md-row shadow-sm m-3">
										<div class="card-body d-flex flex-column flex-md-row justify-content-md-between align-items-center p-3">
											<p class="mb-1">{{ booking.id }}</p>
											<p class="mb-1">{{ booking.user.lastName }}
												{{ booking.user.firstName }}</p>
											<p class="mb-1">{{ booking.room.name }}</p>
											<p class="mb-1">
												{{ booking.startingDate ? booking.startingDate|date('d/m/Y') : '' }}
												-
												{{ booking.endingDate ? booking.endingDate|date('d/m/Y') : '' }}
											</p>
											<p class="mb-1">{{ booking.totalAmount }}
												€
											</p>
                      <p class="mb-1">{{ booking.status.value }} </p>
										</div>
										<div class="d-flex justify-content-center m-3 py-3">
											<a class="btn" target="_blank" href="{{ path('app_booking_show', { id: booking.id }) }}">Voir</a>
										</div>
									</div>
								{% else %}
									<p class="text-center m-2">
										Aucune nouvelle réservation pour le moment
									</p>
								{% endfor %}

							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
