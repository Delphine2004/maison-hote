{% extends 'base.html.twig' %} {% block title %}Booking index{% endblock %} {%
block body %}
<main class="pt-5">
    <section class="container-fluid py-5">
        <div class="container">
            <h1>Booking index</h1>

            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>StartingDate</th>
                        <th>EndingDate</th>
                        <th>TotalAmount</th>
                        <th>Status</th>
                        <th>CreatedAt</th>
                        <th>UpdatedAt</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for booking in bookings %}
                    <tr>
                        <td>{{ booking.id }}</td>
                        <td>
                            {{ booking.startingDate ? booking.startingDate|date('Y-m-d H:i:s') : '' }}
                        </td>
                        <td>
                            {{ booking.endingDate ? booking.endingDate|date('Y-m-d H:i:s') : '' }}
                        </td>
                        <td>{{ booking.totalAmount }}</td>
                        <td>{{ booking.status }}</td>
                        <td>
                            {{ booking.createdAt ? booking.createdAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                        <td>
                            {{ booking.updatedAt ? booking.updatedAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                        <td>
                            <a
                                class="btn"
                                href="{{
                                    path('app_booking_show', { id: booking.id })
                                }}"
                                >show</a
                            >
                            <a
                                class="btn"
                                href="{{
                                    path('app_booking_edit', { id: booking.id })
                                }}"
                                >edit</a
                            >
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="8">no records found</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            <a class="btn" href="{{ path('app_booking_new') }}">Create new</a>
        </div>
    </section>
</main>
{% endblock %}
