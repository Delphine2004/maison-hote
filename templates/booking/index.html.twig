{% extends 'base.html.twig' %}
{% block title %}Réservations
{% endblock %}
{% block body %}
	<main
		class="py-5">

		<!-- Ajouter ou rechercher une réservation  -->
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-3">Réservations</h1>
							</div>
							<div class="card-body p-5">
								<div class="row justify-content-center g-3">

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_search_room') }}">Ajouter</a>
									</div>

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_search_booking') }}">Rechercher</a>
									</div>

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_booking_statistics') }}">Statistiques</a>
									</div>

								</div>
							</div>
						</div>

					</div>
				</div>
			</div>
		</section>

		<!-- Liste des nouvelles réservations -->
		<section class="container-fluid">
			<div
				class="container">
				<!-- Liste -->
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h2 class="text-center">
									Réservations du jour
								</h2>
							</div>

							<div class="card-body p-0">
								{% for booking in todayBookings %}
									<div class="card flex-md-row justify-content-center align-items-center shadow-sm m-3">
										<div class="row justify-content-center align-items-center w-100 g-3">

											<div class="col-12 col-md-9">
												<div class="d-flex flex-column flex-md-row justify-content-between align-items-center p-3">

													<div class="d-flex flex-column justify-content-between custom-size">
														<p class="fw-bold text-center text-md-start my-3">
															{{ booking.startingDate ? booking.startingDate|date('d/m/Y') : '' }}
															-
															{{ booking.endingDate ? booking.endingDate|date('d/m/Y') : '' }}</p>
														<p class="fw-bold text-center text-md-start my-3">{{ booking.user.lastName }}
															{{ booking.user.firstName }}</p>

													</div>
													<div class="d-flex flex-row flex-md-column justify-content-between custom-size">
														<p class="my-3">{{ booking.room.name }}</p>
														<p class="my-3">{{ booking.totalAmount }}€</p>

													</div>
													<div class="d-flex flex-row flex-md-column justify-content-between custom-size">
														<p class="my-3">Ref :
															{{ booking.id }}</p>
														<p class="my-3">{{ booking.status.value }}
														</p>

													</div>
												</div>
											</div>

											<div class="col-12 col-md-2 text-center my-3">
												<a class="btn w-100" target="_blank" href="{{ path('app_booking_show', { id: booking.id }) }}">Voir</a>
											</div>

										</div>
									</div>
								{% else %}
									<p class="text-center m-2">
										Aucune nouvelle réservation pour le moment
									</p>
								{% endfor %}

							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
