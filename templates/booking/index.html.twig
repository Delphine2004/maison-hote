													</strong>
													{{ booking.id }}
												</p>
												<p class="mb-1">
													<strong>Client :
													</strong>
													{{ booking.user.lastName }}
													{{ booking.user.firstName }}
												</p>
												<p class="mb-1">
													<strong>Chambre :
													</strong>
													{{ booking.room.name }}
												</p>
												<p class="mb-1">
