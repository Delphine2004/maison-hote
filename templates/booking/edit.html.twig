{% extends 'base.html.twig' %}
{% block title %}Paramétrage - Modification réservation
{% endblock %}
{% block body %}
	<main class="py-5">
		<section id="event-page" class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card bg-blue border-gold shadow-sm d-flex justify-content-evenly p-4 my-5">
							<h1 class="text-center text-gold m-5">Modifier la réservation</h1>
							{{include("booking/_form.html.twig", {button_label: "Modifier"})}}
						</div>
					</div>
					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_booking_show', { id: booking.id }) }}">Retour sur la réservation</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
