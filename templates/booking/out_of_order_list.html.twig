{% extends 'base.html.twig' %}
{% block title %}Chambres hors service
{% endblock
%}
{% block body %}
	<main class="py-5">
		<section class="container-fluid my-5">
			<div class="container">

				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_booking_index') }}">Retour aux réservations</a>
						</div>
					</div>

					<div class="col-12 col-md-10 col-lg-8">

						<div class="card shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center text-gold m-5">Chambre(s) hors service</h1>
							</div>

							<div class="card-body p-0">
								<div class="row flex-column justify-content-center align-items-center">

									{% for label, messages in app.flashes %}
										<div class="col-12 col-md-10">
											{% for message in messages %}
												<p class="fw-bold text-center  m-3 alert alert-{{ label }}">
													{{ message }}
												</p>
											{% endfor %}
										</div>
									{% endfor %}

									<div class="col-12 col-md-4">
										<div class="text-center m-3">
											<a class="btn btn-sm" href="{{path('app_block_room')}}">Bloquer une chambre</a>
										</div>
									</div>

									<div class="col-12 ">
										{% for outOfOrder in outOfOrders %}
											<div class="card d-flex flex-row flex-wrap align-items-center shadow-sm m-3">
												<div class="card-body d-flex flex-row flex-wrap justify-content-between align-items-center p-3">
													<p class="m-0">{{ outOfOrders.name }}</p>
													<p class="m-0">du {{ outOfOrders.startingDate }} au {{ outOfOrders.endingDate }}</p>
												</div>
												<div class="d-flex justify-content-center align-items-center p-3">
													<div class="text-center py-3">{{ include("booking/_unblock.html.twig" )}}</div>
												</div>
											</div>
										{% else %}
											<p class="text-center m-2">
												Aucune chambre bloquée
											</p>
										{% endfor %}

									</div>

						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
