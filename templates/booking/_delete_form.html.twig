<form
    method="post"
    action="{{ path('app_booking_delete', { id: booking.id }) }}"
    onsubmit="return confirm('Confirmez vous la suppression?');"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('delete' ~ booking.id) }}"
    />
    <button class="btn w-100">Supprimer</button>
</form>
