{% extends 'base.html.twig' %}
{% block title %}Rechercher une période
{% endblock %}
{% block body %}
	<main
		class="py-5">

		<!-- Recherche de période -->
		<section class="container-fluid">
			<div class="container">

				<div class="row justify-content-center mt-3">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card bg-blue shadow-sm p-3 my-5">
							<h1 class="text-center my-4">Séléctionner une période</h1>
							{{ include("home/_search_room.html.twig") }}
						</div>

					</div>
					{% for label, messages in app.flashes %}
						<div class="col-12 col-md-10">
							{% for message in messages %}
								<p class="fw-bold text-center  m-3 alert alert-{{ label }}">
									{{ message }}
								</p>
							{% endfor %}
						</div>
					{% endfor %}
				</div>

			</div>
		</section>

		<section class="container-fluid">
			<div class="container">

				<div class="row justify-content-center align-items-center my-4">
					<div class="col-12 col-md-10 col-lg-8">

						{% for room in rooms %}
							<div class="card flex-column flex-md-row align-items-center shadow-sm my-2">

								<div class="row justify-content-center align-items-center w-100 g-3">
									<div class="col-12 col-md-9">

										<div class="d-flex flex-column flex-md-row justify-content-between align-items-center p-3">
											<div class="d-flex flex-row flex-md-column justify-content-between custom-size">
												<p class="fw-bold text-center text-md-start my-3">{{ room.name }}</p>
												<p class="fw-bold text-center text-md-start my-3">{{ room.rate }}€</p>
											</div>
											<div class="d-flex flex-row flex-md-column justify-content-between custom-size">
												<p class="my-3">{{ room.nights }}
													nuits</p>
												<p class="my-3">Total :
													{{ room.total_price }}€</p>
											</div>
										</div>

									</div>

									<div class="col-12 col-md-2 text-center my-3">
										<a class="btn" target="_blank" href="{{ path('app_search_client_to_booking', { roomId: room.id })}}">Choisir</a>
									</div>

								</div>
							</div>

						{% else %}
							<p class="text-center m-2">
								Aucune chambre disponible pour cette période
							</p>
						{% endfor %}

					</div>
				</div>

			</div>
		</section>
		<main>
		{% endblock %}
