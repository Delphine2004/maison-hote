<form
    method="post"
    action="{{ path('app_unblock', { id: outOfOrder.id }) }}"
    onsubmit="return confirm('Confirmez vous le déblocage?');"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('unblock' ~  outOfOrder.id) }}"
    />
    <button class="btn w-100">Débloquer</button>
</form>