<form
    method="post"
    action="{{ path('app_booking_checkout', { id: booking.id }) }}"
    onsubmit="return confirm('Confirmez vous le déblocage?');"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('unblock' ~ booking.id) }}"
    />
    <button class="btn w-100">Débloquer</button>
</form>