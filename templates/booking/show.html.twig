{% extends 'base.html.twig' %} {% block title %}Booking{% endblock %} {% block
body %}
<main class="pt-5">
    <section class="container-fluid py-5">
        <div class="container">
            <h1>Booking</h1>

            <table class="table">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ booking.id }}</td>
                    </tr>
                    <tr>
                        <th>StartingDate</th>
                        <td>
                            {{ booking.startingDate ? booking.startingDate|date('Y-m-d H:i:s') : '' }}
                        </td>
                    </tr>
                    <tr>
                        <th>EndingDate</th>
                        <td>
                            {{ booking.endingDate ? booking.endingDate|date('Y-m-d H:i:s') : '' }}
                        </td>
                    </tr>
                    <tr>
                        <th>TotalAmount</th>
                        <td>{{ booking.totalAmount }}</td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td>{{ booking.status }}</td>
                    </tr>
                    <tr>
                        <th>CreatedAt</th>
                        <td>
                            {{ booking.createdAt ? booking.createdAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                    </tr>
                    <tr>
                        <th>UpdatedAt</th>
                        <td>
                            {{ booking.updatedAt ? booking.updatedAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                    </tr>
                </tbody>
            </table>

            <a class="btn" href="{{ path('app_booking_index') }}"
                >back to list</a
            >

            <a
                class="btn"
                href="{{ path('app_booking_edit', { id: booking.id }) }}"
                >edit</a
            >

            {{ include("booking/_delete_form.html.twig") }}
        </div>
    </section>
</main>
{% endblock %}
