{{ form_start(form, {'attr': {'novalidate':  true}}) }}
<div class="row g-3 justify-content-around my-3">
	<div class="col-md-4">
		{{ form_label(form.id) }}
		{{ form_widget(form.id, {
        attr: {
            class: 'form-control'
        }
    }) }}
	</div>
	<div class="col-md-4">
		{{ form_label(form.lastName) }}
		{{ form_widget(form.lastName, {
        attr: {
            class: 'form-control'
        }
    }) }}
	</div>
	<div class="col-md-4">
		{{ form_label(form.status) }}
		{{ form_widget(form.status, {
        attr: {
            class: 'form-select'
        }
    }) }}
	</div>
</div>

<div class="row g-3 justify-content-around my-3">
	<div class="col-md-4">
		{{ form_label(form.startingDate) }}
		{{ form_widget(form.startingDate, {
        attr: {
            class: 'form-control'
        }
    }) }}
	</div>
	<div class="col-md-4">
		{{ form_label(form.endingDate) }}
		{{ form_widget(form.endingDate, {
        attr: {
            class: 'form-control'
        }
    }) }}
	</div>
	<div class="col-md-4">
		{{ form_label(form.createdAt) }}
		{{ form_widget(form.createdAt, {
        attr: {
            class: 'form-control'
        }
    }) }}
	</div>
</div>

<div class="row justify-content-center my-3">
	<div class="col-12 col-md-4 mb-3">
		<button class="btn w-100" type="submit">Rechercher</button>
	</div>

	<div class="col-12 text-gold mb-3">
		{{ form_errors(form.id) }}
		{{ form_errors(form.lastName) }}
		{{ form_errors(form.status) }}
		{{ form_errors(form.startingDate) }}
		{{ form_errors(form.endingDate) }}
		{{ form_errors(form.createdAt) }}
		{{ form_errors(form) }}
	</div>

	<div class="col-12 col-md-4 mb-3">
		<div class="text-center text-gold">
			<a href="{{ path('app_search_booking') }}">Réinitialiser</a>
		</div>
	</div>
</div>

{{ form_end(form) }}
