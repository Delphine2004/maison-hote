{% extends 'base.html.twig' %} {% block title %}Les Parenthèses Dorées -
  Gallerie{% endblock %} {% block body %}
  <main class="py-5">
    <section class="container-fluid">
      <div class="container">
        
        <div class="row justify-content-center">
          <div class="col-12 col-md-10 col-lg-8">
            <div class="card card-form shadow-sm p-4 my-5">
              <h1>Statistiques</h1>
              
              <div class="d-flex flex-row justify-content-around p-4"><p>Période du {{ start ? start|date('d/m/Y') : '' }} au {{ end ? end|date('d/m/Y') : ''}}</p></div>
              <div class="d-flex flex-row justify-content-around"><p>TO du jour: {{ occupencyRate }} %</p> 
                <p>Séjour moyen: {{ averageStay }}</p>
              </div>
              <div class="d-flex flex-row justify-content-around pb-4">
                <p>Prix moyen: {{ (arr / 100)|number_format(2, ',', ' ') }}</p>
                <p>RevPar : {{ (revPar / 100)|number_format(2, ',', ' ') }}</p>
              </div>
              {{ include("booking/_statistic_form.html.twig") }}

            </div>
          </div>
        </div>

      </div>
    </section>
  </main>
{% endblock %}
