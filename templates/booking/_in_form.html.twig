<form
    method="post"
    action="{{ path('app_booking_checkin', { id: booking.id }) }}"
    onsubmit="return confirm('Confirmez vous l\'arrivée?');"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('checkin' ~ booking.id) }}"
    />
    <button class="btn">Présent</button>
</form>
