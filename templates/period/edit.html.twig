{% extends 'base.html.twig' %} {% block title %}Paramétrage - Modification
période{% endblock %} {% block body %}
<main class="pt-5">
    <section id="event-page" class="container-fluid py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <h1 class="text-center m-5">Modification période</h1>
                    <div
                        class="card bg-blue border-gold shadow-sm d-flex justify-content-evenly p-4"
                    >
                        {{
                            include("period/_form.html.twig", {
                                button_label: "Modifier"
                            })
                        }}
                    </div>
                </div>
                <div class="text-center m-5">
                    <a
                        class="btn"
                        href="{{ path('app_period_show', { id: period.id }) }}"
                        >Retour sur la période</a
                    >
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
