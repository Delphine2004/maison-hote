{% extends 'base.html.twig' %}

{% block title %}Period{% endblock %}

{% block body %}
    <h1>Period</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ period.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ period.name }}</td>
            </tr>
            <tr>
                <th>StartingDate</th>
                <td>{{ period.startingDate ? period.startingDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>EndingDate</th>
                <td>{{ period.endingDate ? period.endingDate|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ period.createdAt ? period.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ period.updatedAt ? period.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_period_index') }}">back to list</a>

    <a href="{{ path('app_period_edit', {'id': period.id}) }}">edit</a>

    {{ include('period/_delete_form.html.twig') }}
{% endblock %}
