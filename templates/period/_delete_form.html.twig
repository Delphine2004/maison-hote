<form
    method="post"
    action="{{ path('app_period_delete', { id: period.id }) }}"
    onsubmit="return confirm('Confirmez vous la suppression?');"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('delete' ~ period.id) }}"
    />
    <button class="btn w-100">Supprimer</button>
</form>
