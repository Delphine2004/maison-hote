{% extends 'base.html.twig' %} {% block title %}Paramétrage - Périodes{%
endblock %} {% block body %}
<main class="pt-5">

    <section class="container-fluid py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card shadow-sm border-gold m-5">
                        <div class="card-header bg-blue text-gold py-3">
                            <h1 class="text-center m-2">Périodes</h1>
                        </div>
                        <div class="card-body p-0">
                            <div
                                class="table-responsive shadow-sm border d-none d-md-block"
                            >
                                <table
                                    class="table table-hover align-middle mb-0"
                                >
                                    <thead>
                                        <tr>
                                            <th>Nom</th>
                                            <th>Début</th>
                                            <th>Fin</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for period in periods %}
                                        <tr>
                                            <td>{{ period.name }}</td>
                                            <td>
                                                {{ period.startingDate ? period.startingDate|date('d/m/Y') : '' }}
                                            </td>
                                            <td>
                                                {{ period.endingDate ? period.endingDate|date('d/m/Y') : '' }}
                                            </td>

                                            <td>
                                                <div
                                                    class="d-flex justify-content-center gap-2"
                                                >
                                                    <a
                                                        class="btn btn-sm"
                                                        href="{{
                                                            path(
                                                                'app_period_edit',
                                                                {
                                                                    id: period.id
                                                                }
                                                            )
                                                        }}"
                                                        >Modifier</a
                                                    >
                                                    {{
                                                        include(
                                                            "period/_delete_form.html.twig"
                                                        )
                                                    }}
                                                </div>
                                            </td>
                                        </tr>
                                        {% else %}
                                        <tr>
                                            <td colspan="4">
                                                Aucune période enregistrée
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        <div class="card-footer bg-blue">
                            <div class="text-center m-3">
                                <a
                                    class="btn"
                                    href="{{ path('app_period_new') }}"
                                    >Créer une période</a
                                >
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_rate_index') }}"
                    >Retour aux tarifs</a
                >
            </div>
        </div>
    </section>
</main>
{% endblock %}
