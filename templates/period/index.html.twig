{% extends 'base.html.twig' %} {% block title %}Period index{% endblock %} {%
block body %}
<main class="pt-5">
    <section class="container-fluid py-5">
        <div class="container">
            <h1>Period index</h1>

            <table class="table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>StartingDate</th>
                        <th>EndingDate</th>
                        <th>CreatedAt</th>
                        <th>UpdatedAt</th>
                        <th>actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for period in periods %}
                    <tr>
                        <td>{{ period.id }}</td>
                        <td>{{ period.name }}</td>
                        <td>
                            {{ period.startingDate ? period.startingDate|date('Y-m-d') : '' }}
                        </td>
                        <td>
                            {{ period.endingDate ? period.endingDate|date('Y-m-d') : '' }}
                        </td>
                        <td>
                            {{ period.createdAt ? period.createdAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                        <td>
                            {{ period.updatedAt ? period.updatedAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                        <td>
                            <a
                                href="{{
                                    path('app_period_show', { id: period.id })
                                }}"
                                >show</a
                            >
                            <a
                                href="{{
                                    path('app_period_edit', { id: period.id })
                                }}"
                                >edit</a
                            >
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7">no records found</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>

            <a class="btn" href="{{ path('app_period_new') }}">Create new</a>
        </div>
    </section>
</main>
{% endblock %}
