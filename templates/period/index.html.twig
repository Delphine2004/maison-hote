{% extends 'base.html.twig' %}
{% block title %}Paramétrage - Périodes
{% endblock %}
{% block body %}
	<main class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card shadow-sm border-gold my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-3">Périodes</h1>
							</div>
							<div class="card-body p-0">
								{% for period in periods %}
									<div class="card d-flex flex-md-row shadow-sm m-3">
										<div class="card-body d-flex flex-column flex-md-row justify-content-md-between align-items-center p-3">
											<p class="mb-1">
												{{ period.name }}
											</p>
											<p class="mb-1">
												{{ period.startingDate ? period.startingDate|date('d/m/Y') : '' }}
											</p>
											<p class="mb-1">
												{{ period.endingDate ? period.endingDate|date('d/m/Y') : '' }}
											</p>
										</div>
										<div class="d-flex flex-row flex-md-row justify-content-center align-items-center gap-3 p-3">
											<div class="flex-fill d-flex justify-content-center">
												<a class="btn" href="{{ path( 'app_period_edit', { id: period.id } ) }}">Modifier</a>
											</div>
											<div class="flex-fill d-flex justify-content-center">
												{{include("period/_delete_form.html.twig")}}
											</div>
										</div>
									</div>
								{% else %}
									<p class="text-center m-2">
										Aucune période enregistrée
									</p>
								{% endfor %}
							</div>
							<div class="card-footer bg-blue py-3">
								<div class="text-center m-3">
									<a class="btn" href="{{ path('app_period_new') }}">Ajouter une période</a>
								</div>
							</div>
						</div>

					</div>
				</div>

				<div class="text-center mb-5">
					<a class="btn" href="{{ path('app_rate_index') }}">Retour aux tarifs</a>
				</div>

			</div>
		</section>
	</main>
{% endblock %}
