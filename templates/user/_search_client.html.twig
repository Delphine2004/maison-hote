{{ form_start(form, {'attr': {'novalidate':  true}}) }}
<div class="row g-3 mb-3 justify-content-around">
	<div class="col-md-4">
		{{ form_label(form.id) }}
		{{ form_widget(form.id) }}
		{{ form_errors(form.id) }}
	</div>
	<div class="col-md-4">
		{{ form_label(form.lastName) }}
		{{ form_widget(form.lastName) }}
		{{ form_errors(form.lastName) }}
	</div>
	<div class="col-md-4">
		{{ form_label(form.email) }}
		{{ form_widget(form.email) }}
		{{ form_errors(form.email) }}
	</div>
</div>

<div class="row g-3 mb-3 justify-content-around">
	<div class="col-md-4">
		<button class="btn w-100" type="submit">Rechercher</button>
	</div>
</div>

<div class="row g-3 mb-3 justify-content-around">
	<div class="col-md-2 my-4">
		<a class="btn btn-sm" href="{{ path('app_search_client') }}">
			Reset
		</a>
	</div>
</div>

{{ form_end(form) }}
