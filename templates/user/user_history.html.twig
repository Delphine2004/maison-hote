{% extends 'base.html.twig' %}
{% block title %}Historique
{% endblock %}
{%
block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center text-gold m-3">
									Historique
								</h1>
							</div>

							<div class="card-body p-0">
								{% for booking in bookings %}
									<div class="card flex-md-row justify-content-center align-items-center shadow-sm m-3">
										<div class="row justify-content-center align-items-center w-100 g-3">
											<div class="col-12 col-md-9">
												<div class="d-flex flex-column justify-content-between align-items-center p-3">
													<div class="d-flex flex-row justify-content-between custom-size w-100">
														<p class="fw-bold text-center text-md-start my-3">
															{{ booking.startingDate ? booking.startingDate|date('d/m/Y') : '' }}
															-
															{{ booking.endingDate ? booking.endingDate|date('d/m/Y') : '' }}</p>
													</div>
													<div class="d-flex flex-row justify-content-between custom-size w-100">
														<p class="my-3">{{ booking.room.name }}</p>
														<p class="my-3">{{ booking.totalAmount }}€</p>
													</div>
													<div class="d-flex flex-row justify-content-between custom-size w-100">
														<p class="my-3">{{ booking.id }}</p>
														<p class="my-3">{{ booking.status.value }}</p>
													</div>
												</div>
											</div>

										</div>
									</div>
								{% else %}
									<tr>
										<p class="text-center m-5">
											Aucun historique trouvé.
										</p>
									</tr>
								{% endfor %}
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="text-center m-5">
				<a class="btn" href="{{ path('app_client_show', { id: user.id }) }}">Retour</a>
			</div>
		</div>
	</div>
</section></main>{% endblock %}
