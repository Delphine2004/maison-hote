{% extends 'base.html.twig' %}
{% block title %}Historique
{% endblock %}
{%
block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card border-gold shadow-sm">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center text-gold m-3">
									Historique
								</h1>
							</div>
							<div class="card-body p-0">
								{% for booking in bookings %}
									<div class="card d-flex flex-md-row shadow-sm m-3">
										<div class="card-body d-flex flex-column flex-md-row justify-content-md-between align-items-center p-3">
											<p class="mb-1">
												{{ booking.startingDate ? booking.startingDate|date('d/m/Y') : ''}}
											</p>
											<p class="mb-1">
												{{ booking.endingDate ? booking.endingDate|date('d/m/Y') : '' }}
											</p>
											<p class="mb-1">
												{{ booking.room.name }}
											</p>
											<p class="mb-1">
												{{ booking.status.value }}
											</p>
											<p class="mb-1"></p>
										</div>
									</div>
								{% else %}
									<tr>
										<p class="text-center m-2">
											Aucun historique trouvé.
										</p>
									</tr>
								{% endfor %}
							</div>
						</div>
					</div>
				</div>
			</div>
			<div class="text-center m-5">
				<a class="btn" href="{{ path('app_client_show', { id: user.id }) }}">Retour</a>
			</div>
		</div>
	</div>
</section></main>{% endblock %}
