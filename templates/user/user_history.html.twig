{% extends 'base.html.twig' %}
{% block title %}Historique
{% endblock %}
{%
block body %}
	<main class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm border-gold">
							<div class="card-header bg-blue text-gold">
								<h1 class="text-center text-gold m-3">
									Historique
								</h1>
							</div>
							<div class="card-body p-0">
								<div class="table-responsive shadow-sm">
									<table class="table table-hover align-middle mb-0">
										<thead>
											<tr>
												<th scope="col">Arrivée</th>
												<th scope="col">Départ</th>
												<th scope="col">Chambre</th>
												<th scope="col">Statut</th>
											</tr>
										</thead>
										<tbody>

											{% for booking in bookings %}
												<tr>
													<td>{{ booking.startingDate ? booking.startingDate|date('d/m/Y') : ''}}</td>
													<td>{{ booking.endingDate ? booking.endingDate|date('d/m/Y') : '' }}</td>
													<td>{{ booking.room.name }}</td>
													<td>{{ booking.status.value }}</td>
												</tr>
											{% else %}
												<tr>
													<td colspan="4">
														Aucun historique trouvé.
													</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					</div>
					<div class="text-center m-5">
						<a class="btn" href="{{ path('app_client_show', { id: user.id }) }}">Retour</a>
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
