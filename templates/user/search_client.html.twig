{% extends 'base.html.twig' %}
{% block title %}Rechercher client
{% endblock %}
{% block body %}
	<main class="py-5">

		<section class="container-fluid">
			<div class="container">

				<div class="row justify-content-center">
					<div
						class="col-12 col-md-10 col-lg-8">

						<!-- Récapitulatif -->
						<div class="card bg-blue shadow-sm d-flex justify-content-evenly p-4 my-5">
							<div class="d-flex flex-column p-3">
								<h1 class="text-center my-4">Récapitulatif</h1>
								<div class="d-flex flex-row justify-content-between py-2 text-beige">
									<p>Date d'arrivée :</p>
									<p>{{ period.startingDate ? period.startingDate|date('d/m/Y') : ''}}</p>
								</div>
								<div class="d-flex flex-row justify-content-between py-2 text-beige">
									<p>Date de départ :</p>
									<p>{{ period.endingDate ? period.endingDate|date('d/m/Y') : '' }}</p>
								</div>
								<div class="d-flex flex-row justify-content-between py-2 text-beige">
									<p>Chambre :</p>
									<p>{{ room.name }}</p>
								</div>
								<div class="d-flex flex-row justify-content-between py-2 text-beige">
									<p>Prix par nuit :</p>
									<p>{{ room.rate }}</p>
								</div>
								<div class="d-flex flex-row justify-content-between py-2 text-beige">
									<p>Total séjour :</p>
									<p>à faire</p>
								</div>
							</div>
						</div>

						<!-- Client -->
						<div class="card bg-blue shadow-sm d-flex justify-content-evenly p-4 my-5">
							<div class="d-flex flex-column align-content-center p-3">
								<h2 class="text-center my-3">Client</h2>
								<div class="text-center m-4">
									<a class="btn" target="_blank" href="{{ path('app_client_new')}}">Ajouter un client</a>
								</div>

								{{ include("user/_search_client.html.twig") }}
							</div>

						</div>

					</div>
				</div>
			</section>

			<section class="container-fluid">
				<div class="container">

					<div class="row justify-content-center align-items-center my-4">
						<div class="col-12 col-md-10 col-lg-8">

							{% for user in users %}
								<div class="card flex-row justify-content-between align-items-center shadow-sm p-3 my-2">
									<p class="my-3">{{ user.firstName }}
										{{ user.lastName }}</p>
									<a class="btn" target="_blank" href="{{ path('app_booking_new_by_staff', { roomId: room.id, userId: user.id })}}">Choisir
									</a>
								</div>
							{% else %}
								<p class="text-center m-2">
									Aucun client ne correspond à la recherche
								</p>
							{% endfor %}

						</div>
					</div>
				</div>
			</div>
		</div>

	</div>
</section></main>{% endblock %}
