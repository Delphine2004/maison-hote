{% extends 'base.html.twig' %}

{% block title %}Espace utilisateur - Client
{% endblock %}

{% block body %}

	<main
		class="py-5">

		<!-- Ajouter un client -->
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-3">Clients</h1>
							</div>

							<div class="card-body p-5">
								<div class="row justify-content-center g-3">

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_client_new') }}">Ajouter un client</a>
									</div>

									{% for label, messages in app.flashes %}
										<div class="col-12 col-md-10">
											{% for message in messages %}
												<p class="fw-bold text-center  m-3 alert alert-{{ label }}">
													{{ message }}
												</p>
											{% endfor %}
										</div>
									{% endfor %}
								</div>

							</div>

						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Recherche de client -->
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card bg-blue shadow-sm border-gold text-gold p-3 my-5">
							<h3 class="text-center my-3">Rechercher</h3>
							{{ include("user/_search_client.html.twig") }}
						</div>
					</div>
				</div>

				<div class="row justify-content-center align-items-center my-4">
					<div class="col-12 col-md-10 col-lg-8">

						{% for user in users %}
							<div class="card shadow-sm d-flex flex-column flex-md-row align-items-center p-1 m-1">
								<div class="d-flex flex-column flex-md-row justify-content-between align-items-center flex-grow-1 m-3">
									<p class="my-3">{{ user.id }}</p>
									<p class="my-3">{{ user.lastName }}
										{{ user.firstName }}</p>
									<p class="my-3">{{ user.email }}</p>
								</div>
								<div class="m-3">
									<a class="btn" target="_blank" href="{{ path('app_client_show', { id: user.id }) }}">Voir</a>
								</div>
							</div>
						{% else %}
							<p class="text-center m-2">
								Aucun client ne correspond à la recherche.
							</p>
						{% endfor %}


					</div>

				</div>

			</div>
		</section>
	</main>
{% endblock %}
