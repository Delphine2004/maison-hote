{% extends 'base.html.twig' %} {% block title %}Espace utilisateur - Tableau de
bord{% endblock %} {% block body %}
<main class="pt-5">
    <h1 class="text-center m-5">Tableau de bord</h1>

    <!-- Clients présents -->
    <section class="container-fluid pb-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card shadow-sm border-gold">
                        <div class="card-header bg-blue text-gold py-3">
                            <h3 class="mb-0 text-center">Clients présents</h3>
                        </div>
                        <div class="card-body p-0">
                            <!-- Version mobile -->
                            <div class="d-md-none">
                                {% for booking in inhouses %}
                                <div class="card m-2 shadow-sm">
                                    <div class="card-body">
                                        <p class="mb-1">
                                            <strong>Ref : </strong
                                            >{{ booking.id }}
                                        </p>
                                        <p class="mb-1">
                                            <strong>Client : </strong>
                                            {{ booking.client.lastName }}
                                            {{ booking.client.firstName }}
                                        </p>
                                        <p class="mb-1">
                                            <strong>Chambre : </strong>
                                            {{ booking.room.name }}
                                        </p>
                                        <p class="mb-1">
                                            <strong>Séjour : </strong>
                                            {{ booking.startingDate ? booking.startingDate|date('Y-m-d H:i:s') : '' }}
                                            -
                                            {{ booking.endingDate ? booking.endingDate|date('Y-m-d H:i:s') : '' }}
                                        </p>
                                        <p class="mb-1">
                                            <strong>Total : </strong>
                                            {{ booking.totalAmount }}
                                        </p>
                                        <a
                                            class="btn btn-sm"
                                            href="{{
                                                path('app_booking_show', {
                                                    id: booking.id
                                                })
                                            }}"
                                            >Voir</a
                                        >
                                    </div>
                                </div>

                                {% else %}
                                <p class="text-center m-2">
                                    Aucun clients présents
                                </p>
                                {% endfor %}
                            </div>
                            <!-- Version desktop -->
                            <div
                                class="table-responsive shadow-sm d-none d-md-block"
                            >
                                <table
                                    class="table table-hover align-middle mb-0"
                                >
                                    <thead>
                                        <tr>
                                            <th>Ref</th>
                                            <th>Client</th>
                                            <th>Chambre</th>
                                            <th>Arrivée</th>
                                            <th>Départ</th>
                                            <th>Total</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for booking in inhouses %}
                                        <tr>
                                            <td>{{ booking.id }}</td>
                                            <td>
                                                {{ booking.client.lastName }}
                                                {{ booking.client.firstName }}
                                            </td>
                                            <td>{{ booking.room.name }}</td>
                                            <td>
                                                {{ booking.startingDate ? booking.startingDate|date('Y-m-d H:i:s') : '' }}
                                            </td>
                                            <td>
                                                {{ booking.endingDate ? booking.endingDate|date('Y-m-d H:i:s') : '' }}
                                            </td>
                                            <td>{{ booking.totalAmount }}</td>
                                            <td>
                                                <a
                                                    class="btn btn-sm"
                                                    href="{{
                                                        path(
                                                            'app_booking_show',
                                                            {
                                                                id: booking.id
                                                            }
                                                        )
                                                    }}"
                                                    >Voir</a
                                                >
                                            </td>
                                        </tr>
                                        {% else %}
                                        <tr>
                                            <td colspan="7">
                                                Aucun clients présents
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

