                                    </td>
                                </tr>
                                {% else %}
                                <tr>
                                    <td colspan="8">
                                        Aucune arrivée aujourd'hui
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>
{% endblock %}
