{% extends 'base.html.twig' %}
{% block title %}Espace utilisateur -
												Client
{% endblock %}
{% block body %}
	<main class="pt-5">
		<h1 class="text-center m-5">Clients</h1>
		<!-- Créer un client -->
		<section class="container-fluid pb-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card bg-blue shadow-sm border-gold text-gold py-3">
							<div class="text-center m-3">
								<a class="btn" href="{{ path('app_client_new') }}">Créer un client</a>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Recherche de client -->
		<section class="container-fluid pb-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="bg-blue border-gold card p-4 shadow-sm mb-4">
							<h3 class="text-center text-gold mb-4">Rechercher</h3>

							<form method="GET" action="{{ path('app_client_index') }}">
								<div
									class="row g-3 mb-3 d-flex justify-content-around">
									<!-- Id -->
									<div class="col-md-4">
										<label class="form-label" for="client-id">Référence</label>
										<input class="form-control" type="number" name="userId" id="client-id" min="1" step="1"/>
									</div>

									<!-- Nom client -->
									<div class="col-md-4">
										<label class="form-label" for="last-name">Nom</label>
										<input class="form-control" type="text" name="last_name" id="last-name" minlenght="2" maxlenght="100"/>
									</div>

									<!-- Email client -->
									<div class="col-md-4">
										<label class="form-label" for="email">Email</label>
										<input class="form-control" type="email" name="email" id="email"/>
									</div>
								</div>

								<div class="text-center">
									<button type="submit" class="btn">
										Rechercher
									</button>
								</div>
							</form>
						</div>
					</div>
				</div>
				<div id="clients-list" class="row justify-content-center align-items-center my-4">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="table-responsive shadow-sm border rounded">
							<table class="table table-hover align-middle mb-0">
								<thead>
									<tr>
										<th scope="col">ID</th>
										<th scope="col">Client</th>
										<th scope="col">Action</th>
									</tr>
								</thead>
								<tbody id="clients-table-body">
									{% for user in users %}
										<tr>
											<td>{{ user.id }}</td>
											<td>{{ user.lastName }}
												{{ user.firstName }}</td>
											<td>
												<a class="btn btn-sm" href="{{ path('app_client_show', { id: user.id }) }}">
													Voir
												</a>
											</td>
										</tr>
									{% else %}
										<tr>
											<td colspan="3" class="text-center">
												Aucun client ne correspond à la recherche.
											</td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
