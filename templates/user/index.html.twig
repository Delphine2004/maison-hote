{% extends 'base.html.twig' %}
{% block title %}Espace utilisateur - Client
{% endblock %}
{% block body %}
	<main
		class="py-5">

		<!-- Ajouter un client -->
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-3">Clients</h1>
							</div>

							<div class="card-body p-5">
								<div class="row justify-content-center g-3">

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_client_new') }}">Ajouter un client</a>
									</div>
                  
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Recherche de client -->
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card bg-blue shadow-sm border-gold text-gold p-3 my-5">
							<h3 class="text-center mb-4">Rechercher</h3>

							<form method="GET" action="{{ path('app_client_index') }}">
								<div
									class="row g-3 mb-3 d-flex justify-content-around">
									<!-- Id -->
									<div class="col-md-4">
										<label class="form-label" for="client-id">Référence</label>
										<input class="form-control" type="number" name="user_id" id="client-id" min="1" step="1"/>
									</div>

									<!-- Nom client -->
									<div class="col-md-4">
										<label class="form-label" for="last-name">Nom</label>
										<input class="form-control" type="text" name="last_name" id="last-name" minlength="2" maxlength="100"/>
									</div>

									<!-- Email client -->
									<div class="col-md-4">
										<label class="form-label" for="email">Email</label>
										<input class="form-control" type="email" name="email" id="email"/>
									</div>
								</div>

								<div class="text-center">
									<button type="submit" class="btn">
										Rechercher
									</button>
								</div>
							</form>
						</div>
					</div>
				</div>

				<div class="row justify-content-center align-items-center my-4">
					<div class="col-12 col-md-10 col-lg-8">

						{% for user in users %}
							<div class="card border-gold shadow-sm d-flex flex-column flex-md-row align-items-center p-1">
								<div class="d-flex flex-column flex-md-row align-items-center flex-grow-1">
									<p class="m-3">{{ user.id }}</p>
									<p class="m-3">{{ user.lastName }}
										{{ user.firstName }}</p>
								</div>
								<div class="m-3">
									<a class="btn" href="{{ path('app_client_show', { id: user.id }) }}">Voir</a>
								</div>
							</div>
						{% else %}
							<p class="text-center m-2">
								Aucun client ne correspond à la recherche.
							</p>
						{% endfor %}


					</div>

				</div>

			</div>
		</section>
	</main>
{% endblock %}
