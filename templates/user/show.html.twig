{% extends 'base.html.twig' %} {% block title %}User{% endblock %} {% block body
%}
<main class="pt-5">
    <section class="container-fluid py-5">
        <div class="container">
            <h1>User</h1>

            <table class="table">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ user.id }}</td>
                    </tr>
                    <tr>
                        <th>Login</th>
                        <td>{{ user.login }}</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>{{ user.email }}</td>
                    </tr>
                    <tr>
                        <th>Password</th>
                        <td>{{ user.password }}</td>
                    </tr>
                    <tr>
                        <th>Roles</th>
                        <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                    </tr>
                    <tr>
                        <th>CreatedAt</th>
                        <td>
                            {{ user.createdAt ? user.createdAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                    </tr>
                    <tr>
                        <th>UpdatedAt</th>
                        <td>
                            {{ user.updatedAt ? user.updatedAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                    </tr>
                </tbody>
            </table>

            <a class="btn" href="{{ path('app_user_index') }}">back to list</a>

            <a class="btn" href="{{ path('app_user_edit', { id: user.id }) }}"
                >edit</a
            >

            {{ include("user/_delete_form.html.twig") }}
        </div>
    </section>
</main>
{% endblock %}
