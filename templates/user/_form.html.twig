{{ form_start(form, {'attr': {'novalidate':  true}}) }}
<div class="row g-3 justify-content-around my-3">

	{% if form.firstName is defined %}
		<div class="col-12 col-md-6 mb-3">
			{{ form_label(form.firstName) }}
			{{ form_widget(form.firstName, {
        attr: {
            class: 'form-control'
        }
    }) }}
			{{ form_errors(form.firstName) }}
		</div>
	{% endif %}

	{% if form.lastName is defined %}
		<div class="col-12 col-md-6 mb-3">
			{{ form_label(form.lastName) }}
			{{ form_widget(form.lastName, {
        attr: {
            class: 'form-control'
        }
    }) }}
			{{ form_errors(form.lastName) }}
		</div>
	{% endif %}

	{% if form.login is defined %}
		<div class="col-12 col-md-6 mb-3">
			{{ form_label(form.login) }}
			{{ form_widget(form.login, {
        attr: {
            class: 'form-control'
        }
    }) }}
			{{ form_errors(form.login) }}
		</div>
	{% endif %}

	{% if form.email is defined %}
		<div class="col-12 col-md-6 mb-3">
			{{ form_label(form.email) }}
			{{ form_widget(form.email, {
        attr: {
            class: 'form-control',
            placeholder: 'exemple@email.com'
        }
    }) }}
			{{ form_errors(form.email) }}
		</div>
	{% endif %}

	{% if form.phone is defined %}
		<div class="col-12 col-md-6 mb-3">
			{{ form_label(form.phone) }}
			{{ form_widget(form.phone, {
        attr: {
            class: 'form-control'
        }
    }) }}
			{{ form_errors(form.phone) }}
		</div>
	{% endif %}
</div>
<div class="row g-3 justify-content-around my-3">
	{% if form.address is defined %}
		<div class="col-12 mb-3">
			{{ form_label(form.address) }}
			{{ form_widget(form.address, {
        attr: {
            class: 'form-control'
        }
    }) }}
			{{ form_errors(form.address) }}
		</div>
	{% endif %}

	{% if form.zipCode is defined %}
		<div class="col-12 col-md-6 mb-3">
			{{ form_label(form.zipCode) }}
			{{ form_widget(form.zipCode, {
        attr: {
            class: 'form-control'
        }
    }) }}
			{{ form_errors(form.zipCode) }}
		</div>
	{% endif %}

	{% if form.city is defined %}
		<div class="col-12 col-md-6 mb-3">
			{{ form_label(form.city) }}
			{{ form_widget(form.city, {
        attr: {
            class: 'form-control'
        }
    }) }}
			{{ form_errors(form.city) }}
		</div>
	{% endif %}
</div>

{% if form.password is defined %}
	<div class="row g-3 justify-content-around my-3">
		<div class="col-12 mb-3">
			{{ form_label(form.password.first) }}
			{{ form_widget(form.password.first, {
        attr: {
            class: 'form-control'
        }
    }) }}
			{{ form_errors(form.password.first) }}
		</div>
    		<div class="col-12 mb-3">
			{{ form_label(form.password.second) }}
			{{ form_widget(form.password.second, {
        attr: {
            class: 'form-control'
        }
    }) }}
			{{ form_errors(form.password.second) }}
		</div>
	</div>
{% endif %}

<div class="row g-3 justify-content-around my-3">
	<div class="col-12 col-md-4 mb-3">
		<button class="btn w-100">{{ button_label|default('Enregistrer') }}</button>
	</div>

	<div class="col-12 text-gold mb-3">
		{{ form_errors(form) }}
	</div>
</div>
{{ form_end(form) }}
