{% extends 'base.html.twig' %}
{% block title %}Utilisateur
{% endblock %}
{%
block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div
					class="row justify-content-center">

					<!-- Informations compte -->
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center text-gold m-3">Compte</h1>
							</div>

							<div class="card-body">
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Prénom :</strong>
										<span>{{ user.firstName }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>NOM:</strong>
										<span>{{ user.lastName }}</span>
									</div>
								</div>
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Adresse email :</strong>
										<span>{{ user.email }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Téléphone :</strong>
										<span>{{ user.phone }}</span>
									</div>
								</div>
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Adresse :</strong>
										<span>{{ user.address }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Ville et code postal :</strong>
										<span>{{ user.city }}
											{{ user.zipCode }}</span>
									</div>
								</div>
								<div class="py-2 mb-3">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Création :
										</strong>
										<span>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Modification :
										</strong>
										<span>{{user.updatedAt ? user.updatedAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
								</div>
							</div>

							<div class="card-footer bg-blue py-5">
								<div
									class="row justify-content-evenly g-3">
									<!-- Bouton modifier informations -->
									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_client_edit', { id: user.id }) }}">Modifier</a>
									</div>
									<!-- Bouton Supprimer-->
									<div class="col-12 col-md-4">
										<div class="flex-fill">{{include("user/_delete_form.html.twig")}}</div>
									</div>
								</div>
							</div>

						</div>
					</div>


					<!-- Informations réservations -->
					<div class="col-12 col-md-10 col-lg-8 m-4">
						<div class="card border-gold shadow-sm">
							<div class="card-header bg-blue text-gold py-3">
								<h2 class="text-center m-2">Réservation à venir</h2>
							</div>
							<div class="card-body p-0">
								{% for booking in bookings %}
									<div class="card m-2 shadow-sm">
										<div class="card-body">
											<p class="mb-1">
												<strong>Ref :
												</strong>
												{{ booking.id }}
											</p>
											<p class="mb-1">
												<strong>Chambre :
												</strong>
												{{ booking.room.name }}
											</p>
											<p class="mb-1">
												<strong>Séjour :
												</strong>
												{{ booking.startingDate ? booking.startingDate|date('Y-m-d H:i:s') : '' }}
												-
												{{ booking.endingDate ? booking.endingDate|date('Y-m-d H:i:s') : '' }}
											</p>
											<p class="mb-1">
												<strong>Total :
												</strong>
												{{ booking.totalAmount }}
											</p>
                      <p class="mb-1">{{ booking.status.value }} </p>
											<a class="btn" href="{{ path('app_booking_show', { id: booking.id }) }}">Voir</a>
										</div>
									</div>

								{% else %}
									<p class="text-center m-5">
										Aucune réservation à venir
									</p>
								{% endfor %}
							</div>

							<div class="card-footer bg-blue py-5">
								<div class="row justify-content-evenly g-3">
									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_client_booking', { id: user.id }) }}">Historique</a>
									</div>
								</div>
							</div>
						</tbody>
					</div>

				</div>
			</div>
		</section>
	</main>
{% endblock %}
