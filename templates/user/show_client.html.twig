{% extends 'base.html.twig' %}
{% block title %}Utilisateur
{% endblock %}
{%
block body %}
	<main class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">
				<div
					class="row justify-content-center">

					<!-- Informations compte -->
					<div class="col-12 col-md-10 col-lg-8 m-4">
						<div class="card shadow-sm border-gold p-3">
							<div class="row justify-content-md-between align-items-center p-2">
								<h1 class="text-center text-gold m-2">Compte</h1>
								<div class="col-12 px-5">
									<div class="py-2 mb-3 border-bottom">
										<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
											<strong>Prénom :</strong>
											<span>{{ user.firstName }}</span>
										</div>
										<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
											<strong>NOM:</strong>
											<span>{{ user.lastName }}</span>
										</div>
									</div>
									<div class="py-2 mb-3 border-bottom">
										<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
											<strong>Adresse email :</strong>
											<span>{{ user.email }}</span>
										</div>
										<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
											<strong>Téléphone :</strong>
											<span>{{ user.phone }}</span>
										</div>
									</div>
									<div class="py-2 mb-3 border-bottom">
										<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
											<strong>Adresse :</strong>
											<span>{{ user.address }}</span>
										</div>
										<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
											<strong>Ville et code postal :</strong>
											<span>{{ user.city }}
												{{ user.zipCode }}</span>
										</div>
									</div>
									<div class="py-2 mb-3">
										<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
											<strong>Création :
											</strong>
											<span>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i:s') : '' }}
											</span>
										</div>
										<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
											<strong>Modification :
											</strong>
											<span>{{user.updatedAt ? user.updatedAt|date('d/m/Y H:i:s') : '' }}
											</span>
										</div>
									</div>
								</div>

								<div class="col-12 px-5">
									<div
										class="d-flex justify-content-center gap-3">

										<!-- Bouton modifier informations -->
										<div class="flex-fill">
											<a class="btn w-100" href="{{ path('app_client_edit', { id: user.id }) }}">Modifier</a>
										</div>
										<!-- Bouton Supprimer-->
										<div class="flex-fill">{{include("user/_delete_form.html.twig")}}</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<!-- Informations réservations -->
					<div class="col-12 col-md-10 col-lg-8 m-4">
						<div class="card shadow-sm border-gold">
							<div class="card-header bg-blue text-gold">
								<h2 class="text-center m-2">Réservation à venir</h2>
							</div>
							<div class="card-body p-0">
								{% for booking in bookings %}
									<div class="card m-2 shadow-sm">
										<div class="card-body">
											<p class="mb-1">
												<strong>Ref :
												</strong>
												{{ booking.id }}
											</p>
											<p class="mb-1">
												<strong>Chambre :
												</strong>
												{{ booking.room.name }}
											</p>
											<p class="mb-1">
												<strong>Séjour :
												</strong>
												{{ booking.startingDate ? booking.startingDate|date('Y-m-d H:i:s') : '' }}
												-
												{{ booking.endingDate ? booking.endingDate|date('Y-m-d H:i:s') : '' }}
											</p>
											<p class="mb-1">
												<strong>Total :
												</strong>
												{{ booking.totalAmount }}
											</p>
											<a class="btn btn-sm" href="{{ path('app_booking_show', { id: booking.id }) }}">Voir</a>
										</div>
									</div>

								{% else %}
									<p class="text-center m-2">
										Aucune réservation à venir
									</p>
								{% endfor %}
							</div>
							<div class="card-footer bg-blue">
								<div class="text-center m-2">

									<a class="btn" href="{{ path('app_client_booking', { id: user.id }) }}">Historique</a>
								</div>
							</div>
						</tbody>
					</div>
				</div>

			</div>
		</div>
	</section>
</main>{% endblock %}
