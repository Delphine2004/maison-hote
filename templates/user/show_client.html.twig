{% extends 'base.html.twig' %}
{% block title %}Utilisateur
{% endblock %}
{%
block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div
					class="row justify-content-center">

					<!-- Informations compte -->
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm my-5">
							<div class="card-header py-3">
								<h1>Compte</h1>
							</div>

							<div class="card-body">
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Prénom :</strong>
										<span>{{ user.firstName }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>NOM:</strong>
										<span>{{ user.lastName }}</span>
									</div>
								</div>
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Adresse email :</strong>
										<span>{{ user.email }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Téléphone :</strong>
										<span>{{ user.phone }}</span>
									</div>
								</div>
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Adresse :</strong>
										<span>{{ user.address }}</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Ville et code postal :</strong>
										<span>{{ user.city }}
											{{ user.zipCode }}</span>
									</div>
								</div>
								<div class="py-2 mb-3">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Création :
										</strong>
										<span>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Modification :
										</strong>
										<span>{{user.updatedAt ? user.updatedAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
								</div>
							</div>

							<div class="card-footer py-5">
								<div class="row justify-content-evenly g-3">
									{% for label, messages in app.flashes %}
										<div class="col-12 col-md-10">
											{% for message in messages %}
												<p class="fw-bold text-center m-3 alert alert-{{ label }}">
													{{ message }}
												</p>
											{% endfor %}
										</div>
									{% endfor %}
									<!-- Bouton modifier informations -->
									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_client_edit', { id: user.id }) }}">Modifier</a>
									</div>
									<!-- Bouton Supprimer-->
									<div class="col-12 col-md-4">
										<div class="flex-fill">{{include("user/_delete_form.html.twig")}}</div>
									</div>
								</div>
							</div>

						</div>
					</div>


					<!-- Informations réservations -->
					<div class="col-12 col-md-10 col-lg-8 m-4">
						<div class="card shadow-sm">
							<div class="card-header py-3">
								<h2>Réservation à venir</h2>
							</div>
							<div class="card-body p-0">
								{% for booking in bookings %}
									<div class="card flex-md-row justify-content-center align-items-center shadow-sm m-3">
										<div class="row justify-content-center align-items-center w-100 g-3">
											<div class="col-12 col-md-9">
												<div class="d-flex flex-column flex-md-row justify-content-between align-items-center p-3">
													<div class="d-flex flex-column justify-content-between custom-size">
														<p class="fw-bold text-center text-md-start my-3">
															{{ booking.startingDate ? booking.startingDate|date('d/m/Y') : '' }}
															-
															{{ booking.endingDate ? booking.endingDate|date('d/m/Y') : '' }}</p>
													</div>
													<div class="d-flex flex-row flex-md-column justify-content-between custom-size">
														<p class="my-3">{{ booking.room.name }}</p>
														<p class="my-3">{{ booking.totalAmount }}€</p>
													</div>
													<div class="d-flex flex-row flex-md-column justify-content-between custom-size">
														<p class="my-3">{{ booking.id }}</p>
														<p class="my-3">{{ booking.status.value }}</p>
													</div>
												</div>
											</div>

											<div class="col-12 col-md-2 text-center my-3">
												<a class="btn w-100" target="_blank" href="{{ path('app_booking_show', { id: booking.id }) }}">Voir</a>
											</div>


										</div>
									</div>

								{% else %}
									<p class="text-center m-5">
										Aucune réservation à venir
									</p>
								{% endfor %}
							</div>

							<div class="card-footer py-5">
								<div class="row justify-content-evenly">
									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_client_booking', { id: user.id }) }}">Historique</a>
									</div>
								</div>
							</div>
						</tbody>
					</div>

				</div>
			</div>
		</section>
	</main>
{% endblock %}
