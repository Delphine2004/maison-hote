{% extends 'base.html.twig' %}
{% block title %}Modification utilisateur
{% endblock %}

{% block body %}
	<main class="py-5">
		<section id="event-page" class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card bg-blue border-gold shadow-sm d-flex justify-content-evenly p-4 my-5">
							<h1 class="text-center text-gold m-5">Modifier</h1>
							{{include("user/_form.html.twig", {button_label: "Modifier"})}}
						</div>
					</div>
					<div class="col-12 col-md-10 col-lg-8">
						{% if is_granted('ROLE_EMPLOYE') and app.user.id == user.id %}
							<div class="text-center m-3">
								<a class="btn" href="{{ path('app_user_show', { id: user.id }) }}">Retour sur le compte</a>
							</div>
						{% else %}
							<div class="text-center m-3">
								<a class="btn" href="{{ path('app_client_show', { id: user.id }) }}">Retour sur le compte</a>
							</div>
						{% endif %}
					</div>
				</div>
			</section>
		</main>
	{% endblock %}
