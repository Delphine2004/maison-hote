{% extends 'base.html.twig' %}
{% block title %}Paramétrage - Modification
		utilisateur
{% endblock %}
{% block body %}
	<main class="pt-5">
		<section id="event-page" class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card bg-blue border-gold shadow-sm d-flex justify-content-evenly p-4">
							<h1 class="text-center text-gold m-5">Modifier</h1>
							{{
                            include("user/_form.html.twig", {
                                button_label: "Modifier"
                            })
                        }}
						</div>
					</div>
					{% if is_granted('ROLE_EMPLOYE') %}
						<div class="text-center m-5">
							<a class="btn" href="{{ path('app_client_show', { id: user.id }) }}">Retour sur le compte</a>
						</div>
					{% endif %}
				</div>
			</div>
		</section>
	</main>
{% endblock %}
