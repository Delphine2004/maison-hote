{% extends 'base.html.twig' %}
{% block title %}Utilisateur
{% endblock %}
{%
block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card border-gold shadow-sm my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center text-gold m-3">
									Utilisateur
								</h1>
							</div>

							<div class="card-body">
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Nom utilisateur</strong>
										<span>{{ user.login }}</span>
									</div>
								</div>
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Adresse email</strong>
										<span>{{ user.email }}</span>
									</div>
								</div>
								<div class="py-2 mb-3">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Création :
										</strong>
										<span>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Modification :
										</strong>
										<span>{{user.updatedAt ? user.updatedAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
								</div>
							</div>

							<div class="card-footer bg-blue py-5">
								<div class="row justify-content-evenly g-3">

									{% set isAdmin = is_granted('ROLE_ADMIN') %}
									{% set isSelf = app.user.id == user.id %}
									{% set targetIsAdmin = 'ROLE_ADMIN' in user.roles %}
									{% set showDelete = isAdmin and not isSelf and not targetIsAdmin %}

									{% if isAdmin %}
										<div class="col-12 col-md-4">
											<a class="btn w-100" href="{{ path('app_user_edit_by_admin', { id: user.id }) }}">
												Modifier
											</a>
										</div>

										{% if showDelete %}
											<div class="col-12 col-md-4">
												<div class="flex-fill">
													{{ include("admin/_delete_form.html.twig") }}
												</div>
											</div>
										{% endif %}

									{% elseif is_granted('ROLE_EMPLOYE') and isSelf %}
										<div class="col-12 col-md-4">
											<a class="btn w-100" href="{{ path('app_user_edit', { id: user.id }) }}">
												Modifier
											</a>
										</div>

									{% endif %}

								</div>
							</div>
						</div>
					</div>
				</div>

				{# Si admin retour page userlist#}
				{% if is_granted('ROLE_ADMIN') %}
					<div class="text-center m-5">
						<a class="btn" href="{{ path('app_staff_index') }}">Retour aux paramétres</a>
					</div>
				{% endif %}
			</div>
		</section>
	</main>
{% endblock %}
