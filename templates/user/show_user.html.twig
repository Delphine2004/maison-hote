{% extends 'base.html.twig' %}
{% block title %}Utilisateur
{% endblock %}
{%
block body %}
	<main class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm border-gold">
							<div class="card-header bg-blue text-gold">
								<h1 class="text-center text-gold m-3">
									Utilisateur
								</h1>
							</div>
							<div class="card-body">
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Nom utilisateur</strong>
										<span>{{ user.login }}</span>
									</div>
								</div>
								<div class="py-2 mb-3 border-bottom">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Adresse email</strong>
										<span>{{ user.email }}</span>
									</div>
								</div>
								<div class="py-2 mb-3">
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Création :
										</strong>
										<span>{{ user.createdAt ? user.createdAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
									<div class="d-flex flex-column flex-md-row justify-content-md-between py-2">
										<strong>Modification :
										</strong>
										<span>{{user.updatedAt ? user.updatedAt|date('d/m/Y H:i:s') : '' }}
										</span>
									</div>
								</div>
							</div>
							<div class="card-footer bg-blue">
								<div
									class="d-flex flex-column flex-md-row justify-content-center m-5 gap-3">


									{# Bouton Modifier toujours affiché #}


									<div class="{% if is_granted('ROLE_ADMIN') and app.user.id != user.id and 'ROLE_EMPLOYE' in user.roles and 'ROLE_ADMIN' not in user.roles %} flex-fill {% else %} mx-auto {% endif %}">
										<a class="btn w-100" href="{{ path('app_user_edit_by_admin', { id: user.id }) }}">
											Modifier
										</a>
									</div>
									{% if is_granted('ROLE_EMPLOYE') and not is_granted('ROLE_ADMIN') and app.user.id != user.id and 'ROLE_EMPLOYE' in user.roles and 'ROLE_ADMIN' not in user.roles %}
										<div>
											<a class="btn w-100" href="{{ path('app_user_edit', { id: user.id }) }}">
												Modifier
											</a>
										</div>
									{% endif %}
									{# Bouton Supprimer uniquement pour admin sur compte employé différent de lui-même #}
									{% if is_granted('ROLE_ADMIN') and app.user.id != user.id and 'ROLE_EMPLOYE' in user.roles and 'ROLE_ADMIN' not in user.roles %}
										<div class="flex-fill">
											{{include("admin/_delete_form.html.twig")}}
										</div>
									{% endif %}
								</div>
							</div>
						</div>
					</div>
				</div>
				{# Si admin retour page userlist#}
				{% if is_granted('ROLE_ADMIN') %}
					<div class="text-center m-5">
						<a class="btn" href="{{ path('app_staff_index') }}">Retour aux paramétres</a>
					</div>
				{% endif %}
			</div>
		</section>
	</main>
{% endblock %}
