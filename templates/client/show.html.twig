{% extends 'base.html.twig' %} {% block title %}Informations client{% endblock
%} {% block body %}
<main class="pt-5">
    <section class="container-fluid py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card shadow-sm border-gold">
                        <div class="card-header bg-blue text-gold">
                            <h2 class="text-center text-gold m-3">
                                Informations client
                            </h2>
                        </div>
                        <div class="card-body">
                            <!-- Référence client -->
                            <div class="py-2 mb-3 border-bottom">
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Référence :</strong>
                                    <span>{{ user.id }}</span>
                                </div>
                            </div>
                            <!-- Identité -->
                            <div class="py-2 mb-3 border-bottom">
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Prénom :</strong>
                                    <span>{{ user.firstName }}</span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Nom :</strong>
                                    <span>{{ user.lastName }}</span>
                                </div>
                            </div>
                            <!-- Contact -->
                            <div class="py-2 mb-3 border-bottom">
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Email :</strong>
                                    <span>{{ user.email }}</span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Téléphone :</strong>
                                    <span>{{ user.phone }}</span>
                                </div>
                            </div>
                            <!-- Adresse -->
                            <div class="py-2 mb-3 border-bottom">
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Adresse :</strong>
                                    <span>{{ user.address }}</span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Code Postal :</strong>
                                    <span>{{ user.zipCode }}</span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Ville :</strong>
                                    <span>{{ user.city }}</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-blue">
                            <div
                                class="d-flex flex-column flex-md-row justify-content-center m-5 gap-3"
                            >
                                <a
                                    class="btn flex-fill"
                                    href="{{
                                        path('app_user_edit', {
                                            id: user.id
                                        })
                                    }}"
                                >
                                    Modifier
                                </a>

                                <div class="flex-fill">
                                    {{
                                        include("user/_delete_form.html.twig")
                                    }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% if is_granted('ROLE_EMPLOYE') %}
            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_user_index') }}"
                    >Retour aux clients</a
                >
            </div>
            {% else %}
            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_user_index') }}">Retour</a>
            </div>
            {% endif %}
        </div>
    </section>
</main>
{% endblock %}
