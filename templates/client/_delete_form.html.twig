<form
    method="post"
    action="{{ path('app_client_delete', { id: client.id }) }}"
    onsubmit="return confirm('Confirmez vous la suppression?');"
>
    <input
        type="hidden"
        name="_token"
        value="{{ csrf_token('delete' ~ client.id) }}"
    />
    <button class="btn w-100">Delete</button>
</form>
