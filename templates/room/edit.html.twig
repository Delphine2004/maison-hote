{% extends 'base.html.twig' %}
{% block title %}Paramétrage - Modification
			chambre
{% endblock %}
{% block body %}
	<main class="py-5">
		<section id="event-page" class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card card-form shadow-sm justify-content-evenly p-4 my-5">
							<h1>Modifier la chambre</h1>
							{{include("room/_form.html.twig", {button_label: "Modifier"})}}
						</div>
					</div>
					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_room_show', { id: room.id }) }}">Retour sur la chambre</a>
						</div>
					</div>

				</div>
			</div>
		</section>
	</main>
{% endblock %}
