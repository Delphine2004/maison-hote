{{ form_start(form, {'attr': {'novalidate':  true}}) }}
<div class="row g-3 justify-content-around my-3">
	<div class="col-12 mb-3">
		{{ form_label(form.name) }}
		{{ form_widget(form.name, {
        attr: {
            class: 'form-control'
        }
    }) }}
		{{ form_errors(form.name) }}
	</div>

	<div class="col-12 col-md-6 mb-3">
		{{ form_label(form.capacity) }}
		{{ form_widget(form.capacity, {
        attr: {
            class: 'form-control'
        }
    }) }}
		{{ form_errors(form.capacity) }}
	</div>

	<div class="col-12 col-md-6 mb-3">
		{{ form_label(form.rate) }}
		{{ form_widget(form.rate, {
        attr: {
            class: 'form-control'
        }
    }) }}
		{{ form_errors(form.rate) }}
	</div>

	<div class="col-12 mb-3">
		{{ form_label(form.picture) }}
		{{ form_widget(form.picture, {
        attr: {
            class: 'form-control'
        }
    }) }}
		{{ form_errors(form.picture) }}
	</div>

	<div class="col-12 mb-3">
		{{ form_label(form.description) }}
		{{ form_widget(form.description, {
        attr: {
            class: 'form-control',
            rows: 5
        }
    }) }}
		{{ form_errors(form.description) }}
	</div>
</div>

<div class="row g-3 justify-content-around my-3">
	<div class="col-12 col-md-4 mb-3">
		<button class="btn w-100">{{ button_label|default('Enregistrer') }}</button>
	</div>

	<div class="col-12 text-gold mb-3">
		{{ form_errors(form) }}
	</div>
</div>

{{ form_end(form) }}
