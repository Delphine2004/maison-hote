{% extends 'base.html.twig' %} {% block title %}Chambre{% endblock %} {% block
body %}
<main class="pt-5">
    <section class="container-fluid py-5">
        <div class="container">
            <!-- Carte début -->
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div
                        class="card bg-blue border-gold shadow-sm d-flex justify-content-evenly p-4"
                    >
                        <h1 class="text-center text-gold m-5">
                            Chambre : {{ room.name }}
                        </h1>

                        <table class="table">
                            <tbody>
                                <tr>
                                    <th>Id</th>
                                    <td>{{ room.id }}</td>
                                </tr>
                                <tr>
                                    <th>Nom</th>
                                    <td>{{ room.name }}</td>
                                </tr>
                                <tr>
                                    <th>Status</th>
                                    <td>{{ room.status.value }}</td>
                                </tr>
                                <tr>
                                    <th>CreatedAt</th>
                                    <td>
                                        {{ room.createdAt ? room.createdAt|date('Y-m-d H:i:s') : '' }}
                                    </td>
                                </tr>
                                <tr>
                                    <th>UpdatedAt</th>
                                    <td>
                                        {{ room.updatedAt ? room.updatedAt|date('Y-m-d H:i:s') : '' }}
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div
                            class="d-flex flex-column flex-md-row justify-content-center m-5 gap-3"
                        >
                            <a
                                class="btn btn-primary flex-fill"
                                href="{{
                                    path('app_room_edit', { id: room.id })
                                }}"
                            >
                                Modifier
                            </a>

                            <div class="flex-fill">
                                {{ include("room/_delete_form.html.twig") }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Carte fin -->
            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_settings_index') }}"
                    >Retour aux paramétres</a
                >
            </div>
        </div>
    </section>
</main>
{% endblock %}
