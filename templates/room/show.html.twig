{% extends 'base.html.twig' %} {% block title %}Chambre{% endblock %} {% block
body %}
<main class="pt-5">
    <section class="container-fluid py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card shadow-sm border-gold">
                        <div class="card-header bg-blue text-gold">
                            <h2 class="text-center m-3">
                                Chambre : {{ room.name }}
                            </h2>
                        </div>
                        <div class="card-body">
                            <!-- Photo -->
                            <div class="image-wrapper mx-auto mb-4">
                                <img
                                    src="{{ asset('uploads/rooms/' ~ room.picture) }}"
                                    alt=" photo de {{ room.name }}"
                                    class="img-fluid rounded-4"
                                />
                            </div>

                            <!-- Numéro et statut -->
                            <div class="py-2 mb-3 border-bottom">
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Numéro</strong>
                                    <span>{{ room.number }}</span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Statut</strong>
                                    <span>{{ room.status.value }}</span>
                                </div>
                            </div>

                            <!-- Description -->
                            <div
                                class="d-flex flex-column py-2 mb-3 border-bottom"
                            >
                                <strong>Description</strong>
                                <p>{{ room.description }}</p>
                            </div>
                            <div class="py-2 mb-3">
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Création : </strong>
                                    <span
                                        >{{ room.createdAt ? room.createdAt|date('d/m/Y H:i:s') : '' }}
                                    </span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Modification : </strong>
                                    <span
                                        >{{room.updatedAt ? room.updatedAt|date('d/m/Y H:i:s') : '' }}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer bg-blue">
                            <div
                                class="d-flex flex-column flex-md-row justify-content-center m-5 gap-3"
                            >
                                <a
                                    class="btn flex-fill"
                                    href="{{
                                        path('app_room_edit', { id: room.id })
                                    }}"
                                >
                                    Modifier
                                </a>

                                <div class="flex-fill">
                                    {{ include("room/_delete_form.html.twig") }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_hotel_settings') }}"
                    >Retour aux paramétres</a
                >
            </div>
        </div>
    </section>
</main>
{% endblock %}
