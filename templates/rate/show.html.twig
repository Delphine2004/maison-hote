{% extends 'base.html.twig' %} {% block title %}Rate{% endblock %} {% block body
%}
<main class="pt-5">
    <section class="container-fluid py-5">
        <div class="container">
            <h1>Rate</h1>

            <table class="table">
                <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ rate.id }}</td>
                    </tr>
                    <tr>
                        <th>Amount</th>
                        <td>{{ rate.amount }}</td>
                    </tr>
                    <tr>
                        <th>CreatedAt</th>
                        <td>
                            {{ rate.createdAt ? rate.createdAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                    </tr>
                    <tr>
                        <th>UpdatedAt</th>
                        <td>
                            {{ rate.updatedAt ? rate.updatedAt|date('Y-m-d H:i:s') : '' }}
                        </td>
                    </tr>
                </tbody>
            </table>

            <a class="btn" href="{{ path('app_rate_index') }}">back to list</a>

            <a class="btn" href="{{ path('app_rate_edit', { id: rate.id }) }}"
                >edit</a
            >

            {{ include("rate/_delete_form.html.twig") }}
        </div>
    </section>
</main>
{% endblock %}
