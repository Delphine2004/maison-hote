{% extends 'base.html.twig' %} {% block title %}Tarif{% endblock %} {% block
body %}
<main class="pt-5">
    <section class="container-fluid py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-12 col-md-10 col-lg-8">
                    <div class="card shadow-sm border-gold">
                        <div class="card-header bg-blue text-gold">
                            <h2 class="text-center text-gold m-3">Tarif</h2>
                        </div>
                        <div class="card-body">
                            <div class="py-2 mb-3 border-bottom">
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Nom de la chambre</strong>
                                    <span>{{ rate.room.name }}</span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Numéro de la chambre</strong>
                                    <span>{{ rate.room.number }}</span>
                                </div>
                            </div>
                            <div class="py-2 mb-3 border-bottom">
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Tarif</strong>
                                    <span>{{ rate.amount }}€</span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Nom de la période</strong>
                                    <span>{{ rate.period.name }}</span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Date de début</strong>
                                    <span
                                        >{{ rate.period.startingDate ? rate.period.startingDate|date('d/m/Y') : '' }}</span
                                    >
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Date de fin</strong>
                                    <span
                                        >{{ rate.period.endingDate ? rate.period.endingDate|date('d/m/Y') : '' }}</span
                                    >
                                </div>
                            </div>
                            <div class="py-2 mb-3">
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Création : </strong>
                                    <span
                                        >{{ rate.createdAt ? rate.createdAt|date('d/m/Y H:i:s') : '' }}
                                    </span>
                                </div>
                                <div
                                    class="d-flex flex-column flex-md-row justify-content-md-between py-2"
                                >
                                    <strong>Modification : </strong>
                                    <span
                                        >{{rate.updatedAt ? rate.updatedAt|date('d/m/Y H:i:s') : '' }}
                                    </span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-blue">
                            <div
                                class="d-flex flex-column flex-md-row justify-content-center m-5 gap-3"
                            >
                                <a
                                    class="btn flex-fill"
                                    href="{{
                                        path('app_rate_edit', {
                                            id: rate.id
                                        })
                                    }}"
                                >
                                    Modifier
                                </a>

                                <div class="flex-fill">
                                    {{ include("rate/_delete_form.html.twig") }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center m-5">
                <a class="btn" href="{{ path('app_settings_index') }}"
                    >Retour aux paramétres</a
                >
            </div>
        </div>
    </section>
</main>
{% endblock %}
