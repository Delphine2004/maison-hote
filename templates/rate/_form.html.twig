{{ form_start(form, {'attr': {'novalidate':  true}}) }}

<div class="mb-4 text-gold">
    {{ form_label(form.amount) }}
    {{ form_widget(form.amount) }}
    {{ form_errors(form.amount) }}
</div>

<div class="mb-4 text-gold">
    {{ form_label(form.room) }}
    {{ form_widget(form.room) }}
    {{ form_errors(form.room) }}
</div>

<div class="mb-4 text-gold">
    {{ form_label(form.period.name) }}
    {{ form_widget(form.period.name) }}
    {{ form_errors(form.period.name) }}
</div>
<div class="mb-4 text-gold">
    {{ form_label(form.period.startingDate) }}
    {{ form_widget(form.period.startingDate) }}
    {{ form_errors(form.period.startingDate) }}
</div>
<div class="mb-4 text-gold">
    {{ form_label(form.period.endingDate) }}
    {{ form_widget(form.period.endingDate) }}
    {{ form_errors(form.period.endingDate) }}
</div>
<div class="text-center m-2">
    <button class="btn">{{ button_label|default('Enregistrer') }}</button>
</div>
{{ form_end(form) }}
