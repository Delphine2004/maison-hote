{% extends 'base.html.twig' %}
{% block title %}Paramétrage - Tarifs
{% endblock %}
{% block body %}
	<main class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">

				<div class="text-center mt-5">
					<a class="btn" href="{{ path('app_settings_index') }}">Retour aux paramétres</a>
				</div>

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">

						<div class="card shadow-sm border-gold my-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-3">Tarifs</h1>
							</div>

							<div class="card-body p-0">
								<div class="d-flex flex-column flex-md-row justify-content-center gap-3 m-3">
									<a class="btn" href="{{ path('app_period_index') }}">Gérer les périodes</a>
                  <a class="btn" href="{{ path('app_rate_new') }}">Ajouter un tarif</a>
								</div>

								{% for period in periods %}
									{% for rate in period.rates %}
										<div class="card d-flex flex-md-row shadow-sm m-3">
											<div class="card-body d-flex flex-column flex-md-row justify-content-md-between align-items-center p-3">
												<h6 class="fw-bold mb-2">
													{{ period.name }}
												</h6>

												<p class="mb-1">
													{{ rate.room.name }}
												</p>

												<p class="mb-1">
													{{ rate.amount }}
													€
												</p>

												<p class="mb-1">
													{{ period.startingDate|date('d/m/Y') }}
												</p>

												<p class="mb-1">
													{{ period.endingDate|date('d/m/Y') }}
												</p>
											</div>
											<div class="d-flex justify-content-center m-3 py-3">
												<a class="btn" href="{{ path('app_rate_show', { id: rate.id }) }}">
													Voir le tarif
												</a>
											</div>
										</div>
									{% endfor %}
								{% else %}
									<p class="text-center m-2">
										Aucune période tarifaire active
									</p>
								{% endfor %}
							</div>
						</div>

					</div>
				</div>

			</div>
		</section>
	</main>
{% endblock %}
