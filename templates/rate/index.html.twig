{% extends 'base.html.twig' %}
{% block title %}Paramétrage - Tarifs
{%
endblock %}
{% block body %}
	<main
		class="pt-5">
		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm border-gold mb-5">
							<div class="card-header bg-blue text-gold py-3">
								<h1 class="text-center m-2">Tarifs</h1>
							</div>
							<div class="card-body p-0">
								<div class="text-center m-2">
									<a href="{{ path('app_period_index') }}" class="btn btn-sm">
										Gérer les périodes
									</a>
								</div>
								<!-- Version mobile -->
								<div class="d-md-none">
									{% for period in periods %}
										{% for rate in
                                period.rates %}
											<div class="card m-2 shadow-sm">
												<div class="card-body">
													<h6 class="fw-bold mb-2">
														{{ period.name }}
													</h6>

													<p class="mb-1">
														<strong>Chambre :</strong>
														{{ rate.room.name }}
													</p>

													<p class="mb-1">
														<strong>Prix :</strong>
														{{ rate.amount }}
														€
													</p>

													<p class="mb-1">
														<strong>Du :</strong>
														{{ period.startingDate|date('d/m/Y') }}
													</p>

													<p class="mb-1">
														<strong>Au :</strong>
														{{ period.endingDate|date('d/m/Y') }}
													</p>

													<a href="{{ path('app_rate_show', { id: rate.id }) }}" class="btn btn-sm w-100 mt-2">
														Voir le tarif
													</a>
												</div>
											</div>
										{% endfor %}
									{% else %}
										<p class="text-center m-2">
											Aucune période tarifaire active
										</p>
									{% endfor %}
								</div>
								<!-- Version desktop -->
								<div class="table-responsive shadow-sm d-none d-md-block">
									<table class="table table-hover align-middle mb-0">
										<thead>
											<tr>
												<th scope="col">Chambre</th>
												<th scope="col">Prix / nuit</th>
												<th scope="col">Nom</th>
												<th scope="col">Date début</th>
												<th scope="col">Date fin</th>
												<th scope="col">Action</th>
											</tr>
										</thead>
										<tbody>
											{% for period in periods %}
												{% for rate
                                        in period.rates %}
													<tr>
														<td>{{ rate.room.name }}</td>
														<td>{{ rate.amount }}
															€</td>
														<td>{{ period.name }}</td>
														<td>
															{{ period.startingDate ? period.startingDate|date('d/m/Y') : '' }}
														</td>
														<td>
															{{ period.endingDate ? period.endingDate|date('d/m/Y') : '' }}
														</td>
														<td>
															<a class="btn btn-sm" href="{{ path('app_rate_show', { id: rate.id }) }}">Voir</a>
														</td>
													</tr>
												{% endfor %}
											{% else %}
												<tr>
													<td colspan="6">
														Aucune période tarifaire active
													</td>
												</tr>
											{% endfor %}
										</tbody>
									</table>
								</div>
							</div>
							<div class="card-footer bg-blue py-3">
								<div class="text-center m-2">
									<a class="btn" href="{{ path('app_rate_new') }}">Ajouter un tarif</a>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="text-center m-5">
					<a class="btn" href="{{ path('app_settings_index') }}">Retour aux paramétres</a>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
