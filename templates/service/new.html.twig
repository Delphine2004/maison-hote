		<section class="container-fluid py-5">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="card bg-blue border-gold shadow-sm d-flex justify-content-evenly p-4">
							<h1 class="text-center text-gold m-5">Ajouter un service</h1>
							{{ include('service/_form.html.twig') }}
