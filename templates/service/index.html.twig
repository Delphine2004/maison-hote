{% extends 'base.html.twig' %}

{% block title %}Espace administrateur - Services
{% endblock %}

{% block body %}

	<main class="py-5">

		<section class="container-fluid my-5">
			<div class="container">

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_hotel_settings') }}">Retour aux paramétres</a>
						</div>
					</div>

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm my-5">
							<div class="card-header py-3">
								<h1 class="text-center m-3">Services</h1>
							</div>

							<div class="card-body p-5">
								<div class="row justify-content-center">

									<div class="col-12 col-md-4">
										<a class="btn w-100" href="{{ path('app_service_new') }}">Ajouter un service</a>
									</div>

									{% for label, messages in app.flashes %}
										<div class="col-12 col-md-10">
											{% for message in messages %}
												<p class="fw-bold text-center  m-3 alert alert-{{ label }}">
													{{ message }}
												</p>
											{% endfor %}
										</div>
									{% endfor %}
								</div>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>

		<section class="container-fluid my-5 ">
			<div class="container">

				<div class="row justify-content-center g-4">
					{% for service in services %}
						<div class="col-12 col-md-5">
							<div class="card shadow-sm h-100">
								<div class="card-header py-3">
									<h2 class="text-center m-3">{{ service.name }}</h2>
								</div>

								<div class="card-body d-flex flex-column ">
									<p>{{ service.price }}</p>
									<p>{{ service.description }}</p>
								</div>

								<div class="card-footer p-3">
									<div class="row justify-content-center g-3">
										<div class="col-5">
											<a class="btn w-100" href="{{ path('app_service_edit', {'id': service.id}) }}">Modifier</a>
										</div>

										<div class="col-5">
											<div class="flex-fill">
												{{include("service/_delete_form.html.twig")}}
											</div>
										</div>

									</div>
								</div>

							</div>
						</div>
					{% else %}
						<div class="col-12 col-md-5">
							<div class="card shadow-sm my-4">
								<p class="text-center">Aucun service enregistré</p>
							</div>
						</div>
					{% endfor %}

				</div>
			</div>
		</section>

	</main>
{% endblock %}
