{% extends 'base.html.twig' %}
{% block title %}Les Parenthèses Dorées -
							Galerie
{% endblock %}
{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 ">
						<h1 class="text-center text-gold m-3 m-md-5">Galerie</h1>
					</div>
				</div>

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 ">
						<div id="carousel-gallery" class="carousel slide mx-auto">
							<div class="carousel-inner">
								{% for picture in pictures %}
									<div class="carousel-item {% if loop.first %}active{% endif %}">
										<div class="d-flex justify-content-center align-items-center">
											<img src="{{ asset('uploads/pictures/' ~ picture.picture) }}" alt="image {{ picture.id }}">
										</div>
									</div>
								{% else %}
									<div class="carousel-item active">
										<p class="text-center">Aucune photo</p>
									</div>
								{% endfor %}
							</div>

							<button class="carousel-control-prev" type="button" data-bs-target="#carousel-gallery" data-bs-slide="prev">
								<span class="carousel-control-prev-icon"></span>
							</button>

							<button class="carousel-control-next" type="button" data-bs-target="#carousel-gallery" data-bs-slide="next">
								<span class="carousel-control-next-icon"></span>
							</button>
						</div>
					</div>
				</div>

			</div>
		</section>
	</main>
{% endblock %}
