{% extends 'base.html.twig' %}
{% block title %}Les Parenthèses Dorées -
				Recherche
{% endblock %}
{% block body %}
	<main class="py-5">
		<section id="search-bar-room" class="container-fluid d-flex align-items-center py-5">
			<div class="container">
				<div class="card bg-blue border-gold shadow-sm d-flex justify-content-evenly p-4 my-5">
					{{ include("home/_search_room.html.twig") }}
				</div>
			</div>
		</section>
    
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center align-items-center my-4">
					<div class="col-12 col-md-10 col-lg-8">

						{% for room in rooms %}
							<p>{{ room.number }}</p>
              <p>{{ room.name }}</p>
              <p>Nombre de nuit:{{ room.nights }}</p>
              <p>{{ room.total_price }}</p>
              <a class="btn"  target="_blank" href="">Sélectionner </a>
						{% else %}
							<p class="text-center m-2">
								Aucune chambre disponible pour cette période
							</p>
						{% endfor %}

					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
