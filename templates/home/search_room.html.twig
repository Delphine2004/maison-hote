{% extends 'base.html.twig' %}
{% block title %}Les Parenthèses Dorées - Recherche
{% endblock %}
{% block body %}
	<main class="py-5">
		<section id="search-bar-room" class="container-fluid py-5">
			<div class="container">

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 ">

						<div class="card bg-blue border-gold shadow-sm d-flex justify-content-evenly p-4 my-5">
							<h1 class="text-center text-gold my-3">Rechercher</h1>
							{{ include("home/_search_room.html.twig") }}
						</div>

					</div>
				</div>

			</div>
		</section>

		<section class="container-fluid py-5">
			<div class="container">

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 ">

						<div class="d-flex flex-column align-content-center gap-4">
							{% for room in rooms %}
								<div
									class="d-flex flex-column bg-blue text-gold border-gold shadow-sm p-5 my-2">
									<!-- Photo / titre-déscription -->
									<div class="row flex-row justify-content-between align-items-center p-2-">
										<div class="col-12 col-md-6 search-room p-4">
											<img src="{{ asset('uploads/rooms/' ~ room.picture) }}" alt="visuel {{ room.name }}"/>
										</div>
										<div class="col-12 col-md-6 p-4">
											<h2 class="text-center text-gold my-3">{{ room.name }}</h2>
											<p class="text-center text-beige my-3">{{ room.description }}</p>
										</div>
									</div>

									<!-- Récapitulatif / btn -->
									<div class="row flex-row justify-content-between align-items-center border-gold p-2">
										<div class="col-12 col-md-5 p-4">
											<p class="text-beige my-3">Date d'arrivée : {{ data.startingDate ? data.startingDate|date('d/m/Y') : '' }}</p>
                      <p class="text-beige my-3">Date de départ : {{ data.endingDate ? data.endingDate|date('d/m/Y') : '' }}</p>
                      <p class="text-beige my-3">Prix par nuit :
												{{ room.rate }}</p>
											<p class="text-beige my-3">Total séjour :
												{{ room.total_price }}</p>
										</div>
										<div class="col-12 col-md-5 text-center ">
											<a class="btn my-2" target="_blank" href="{{ path('app_booking_new_by_client', { roomId: room.id } ) }}">Choisir
											</a>
										</div>
									</div>

								</div>

							{% else %}
								<p class="text-center m-2">
									Aucune chambre disponible pour cette période
								</p>
							{% endfor %}
						</div>

					</div>
				</div>

			</div>
		</section>
	</main>
{% endblock %}
