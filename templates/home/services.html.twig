{% extends 'base.html.twig' %}
{% block title %}Les Parenthèses Dorées -
		Services
{% endblock %}
{% block body %}
	<main class="py-5">
		<section class="container-fluid my-5">
			<div class="container">

				<div class="row justify-content-center">
					<div class="col-12 col-md-10 ">
						<h1 class="text-center text-brown my-3 my-md-5">Services</h1>
					</div>
					<div class="col-12 col-md-10 ">
						<p class="text-center my-3 my-md-5">Nous mettons tout en œuvre pour rendre votre séjour inoubliable en vous proposant une gamme de services pensés pour votre confort et votre bien-être. Que vous soyez en quête de détente, de découverte ou simplement d'un accueil chaleureux, nous avons à cœur de répondre à toutes vos attentes. Pour toute information complémentaire ou pour réserver l'un de nos services, n'hésitez pas à prendre contact avec nous directement, nous serons ravis de vous accueillir et de vous accompagner dans l'organisation de votre séjour.
						</p>
					</div>
				</div>

				<div class="row justify-content-center g-4">
					{% for service in services %}
						<div class="col-12 col-md-5 ">
							<div class="card shadow-sm my-4">
								<div class="card-header py-3">
									<h2 class="text-center m-3">{{ service.name }}</h2>
								</div>
								<div class="card-body ">
									<p>{{ service.price }}</p>
									<p>{{ service.description }}</p>
								</div>
							</div>
						</div>
					{% else %}
						<p class="text-center">Aucun service enregistré</p>
					{% endfor %}
				</div>
			</div>


		</section>
	</main>
{% endblock %}
